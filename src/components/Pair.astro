---
/* Two paper cards, the Rin site's pair. The first says how the work got
   built, with the stack as a tree. The second is what senior year is running
   alongside. */
const now = [
  ['var(--acc-kyou)', 'shipping Kyou', 'daily'],
  ['var(--acc-volbase)', 'running volbase', 'live'],
  ['var(--acc-me)', 'teaching climbing at the gym', 'weekends'],
  ['var(--acc-market)', 'applying to college', 'this fall'],
];
---
<section class="pair" aria-labelledby="pair-title">
  <h2 class="sr" id="pair-title">How it got built</h2>
  <div class="card up">
    <h3>Taught myself, from the docs</h3>
    <p>No mentor, no bootcamp. Each product started with a problem I had and the
      documentation for whatever could solve it. The stack grew one product at a time.</p>
    <div class="art tree">
      <div><b>stack/</b></div>
      <div><i>├──</i> swift <span>SwiftUI, AppKit, EventKit, WidgetKit</span></div>
      <div><i>├──</i> web <span>Next.js, React, Supabase, Stripe</span></div>
      <div><i>├──</i> python <span>FastAPI, with Chart.js up front</span></div>
      <div><i>└──</i> tools <span>Xcode, Claude Code, GSAP</span></div>
    </div>
  </div>

  <div class="card up">
    <h3>What senior year runs alongside</h3>
    <p>School is the day job. These keep going around it.</p>
    <div class="art live">
      {now.map(([c, t, w]) => (<div class="s"><span class="dot" style={`--c:${c}`}></span>{t}<em>{w}</em></div>))}
    </div>
  </div>
</section>

<style>
  .pair { display: grid; grid-template-columns: 1.35fr 1fr; gap: 20px; padding-top: var(--sec); max-width: var(--wrap); margin-inline: auto; padding-inline: var(--gut); }
  @media (max-width: 860px) { .pair { grid-template-columns: 1fr; } }
  .tree { font-family: var(--mono); font-size: var(--t-fine); line-height: 2; color: var(--ink); padding-bottom: 30px; }
  .tree i { color: var(--hair); font-style: normal; }
  .tree b { font-weight: 700; }
  .tree span { color: var(--ink-3); }
  .live { padding-bottom: 30px; display: grid; gap: 2px; }
  .live .s { display: flex; align-items: center; gap: 10px; font-size: var(--t-small); color: var(--ink); line-height: 2; }
  .live .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--c); box-shadow: 0 0 0 3px color-mix(in oklab, var(--c) 22%, transparent); }
  .live em { font-style: normal; margin-left: auto; font-family: var(--mono); font-size: var(--t-nano); color: var(--ink-3); }
</style>
