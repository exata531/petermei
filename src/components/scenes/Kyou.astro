---
/* Kyou in an iPhone. The screen is DOM and the script in scripts/scenes/kyou.ts
   runs it the way the real app runs: a dark hero with the weekday, the face and
   the forward-looking sentence, a scrubbable day strip, the curtain timeline,
   a glass bar with Day, Work, Settings and the red plus, an add sheet whose
   parser assumes nothing you did not type, an edit sheet on a hold, and the
   settings sheet with the real options. Everything you do is kept while the
   tab is open. With JavaScript off this is one still of the day. */
---
<div class="phone" data-kyou data-drag>
  <div class="ph-screen is-light" data-kyou-screen data-nodrag>
    <div class="ph-status"><span class="ph-time" data-ky-clock>9:41</span><span class="ph-icons" aria-hidden="true"><i class="sig"></i><i class="wifi"></i><i class="bat"></i></span></div>
    <div class="island" aria-hidden="true"></div>
    <div class="ph-home" aria-hidden="true"></div>

    <!-- the Day tab -->
    <div class="ky-page" data-ky-page="day">
      <div class="ky-hero">
        <div class="ky-day">
          <span class="ky-dayname" data-ky-dayname>Today</span><i class="ky-dot" data-ky-dot></i>
          <button class="ky-face" type="button" data-ky-face aria-label="The day's face. Tap for another.">( ˘ω˘ )</button>
        </div>
        <p class="ky-next" data-ky-next>Nothing on the books yet.</p>
        <ul class="ky-week" data-ky-week aria-label="Days"></ul>
        <p class="ky-demo">This is a demo, so tap a to-do to tick it and hold one to edit it.</p>
      </div>
      <div class="ky-curtain" data-ky-curtain>
        <ol class="ky-tl" data-ky-tl aria-label="Timeline"></ol>
      </div>
    </div>

    <!-- the Work tab -->
    <div class="ky-page ky-work" data-ky-page="work" hidden>
      <div class="ky-work-head"><h2>Work</h2><span data-ky-work-count>0 open</span></div>
      <div class="ky-work-list" data-ky-work></div>
    </div>

    <!-- the glass bar: Day, Work, Settings, and the plus -->
    <nav class="ky-bar" aria-label="Tabs">
      <div class="ky-tabs" role="tablist">
        <span class="ky-pill" data-ky-pill aria-hidden="true"></span>
        <button class="ky-tab is-on" type="button" role="tab" aria-selected="true" data-ky-tab="day"><svg viewBox="0 0 20 20" aria-hidden="true"><rect x="3" y="4" width="14" height="13" rx="3"/><path d="M3 8.5h14M7 2.5v3M13 2.5v3"/></svg><span>Day</span></button>
        <button class="ky-tab" type="button" role="tab" aria-selected="false" data-ky-tab="work"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 6.5l1.5 1.5L8 5.5M4 12.5l1.5 1.5L8 11.5M10.5 7h6M10.5 13h6"/></svg><span>Work</span></button>
        <button class="ky-tab" type="button" role="tab" aria-selected="false" data-ky-tab="settings"><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="2.6"/><path d="M10 2.5v2.2M10 15.3v2.2M2.5 10h2.2M15.3 10h2.2M4.7 4.7l1.6 1.6M13.7 13.7l1.6 1.6M15.3 4.7l-1.6 1.6M6.3 13.7l-1.6 1.6"/></svg><span>Settings</span></button>
      </div>
      <button class="ky-plus" type="button" data-ky-plus aria-label="Add"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 4v12M4 10h12"/></svg></button>
    </nav>

    <span class="ky-toast" data-ky-toast role="status" aria-live="polite"></span>

    <!-- the add sheet -->
    <div class="ky-veil" data-ky-veil hidden></div>
    <div class="ky-sheet ky-add" data-ky-sheet="add" role="dialog" aria-label="Add" hidden>
      <div class="ky-field" data-ky-field>
        <span class="ky-paint" data-ky-paint aria-hidden="true"></span>
        <input class="ky-real" data-ky-real data-sim-input aria-label="What is it? Try: physics set friday at 4" placeholder="physics set friday at 4" autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="send" />
        <button class="ky-send" type="button" data-ky-send aria-label="Add it"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 15V5M5.5 9.5 10 5l4.5 4.5"/></svg></button>
      </div>
      <div class="ky-read" data-ky-read aria-live="polite"></div>
      <div class="ky-chips" role="group" aria-label="Kind">
        <button class="ky-chip" type="button" data-ky-kind="todo" aria-pressed="false"><i class="ring"></i>To-do</button>
        <button class="ky-chip" type="button" data-ky-kind="event" aria-pressed="false"><i class="bar"></i>Event</button>
        <span class="ky-chip-hint" data-ky-chip-hint>nothing assumed you did not type</span>
      </div>
    </div>

    <!-- the edit sheet, on a hold -->
    <div class="ky-sheet ky-edit" data-ky-sheet="edit" role="dialog" aria-label="Edit" hidden>
      <div class="ky-sheet-top"><button class="ky-link" type="button" data-ky-edit-cancel>Cancel</button><b>Edit</b><button class="ky-link is-bold" type="button" data-ky-edit-done>Done</button></div>
      <div class="ky-form">
        <div class="ky-seg" role="group" aria-label="Kind"><button class="is-on" type="button" data-ky-edit-kind="todo" aria-pressed="true">To-do</button><button type="button" data-ky-edit-kind="event" aria-pressed="false">Event</button></div>
        <label class="ky-row"><span>Title</span><input data-ky-edit-title data-sim-input type="text" autocomplete="off" /></label>
        <label class="ky-row"><span>When</span><input data-ky-edit-when data-sim-input type="text" placeholder="tomorrow at 4" autocomplete="off" /></label>
        <label class="ky-row"><span>Place</span><input data-ky-edit-place data-sim-input type="text" placeholder="none" autocomplete="off" /></label>
        <p class="ky-form-note" data-ky-edit-read></p>
        <div class="ky-form-acts">
          <button class="ky-act" type="button" data-ky-edit-tomorrow>Move to tomorrow</button>
          <button class="ky-act is-red" type="button" data-ky-edit-delete>Delete</button>
        </div>
      </div>
    </div>

    <!-- settings, a sheet and never a page -->
    <div class="ky-sheet ky-settings" data-ky-sheet="settings" role="dialog" aria-label="Settings" hidden>
      <div class="ky-sheet-top"><span></span><b>Settings</b><button class="ky-link is-bold" type="button" data-ky-settings-done>Done</button></div>
      <div class="ky-list" data-ky-settings></div>
    </div>
  </div>
</div>

<style is:global>
  .phone { position: absolute; inset: 0; background: #0b0b0d; padding: 11px 11px 15px; }
  .ph-screen { position: relative; width: 100%; height: 100%; border-radius: 44px; overflow: clip; background: #000; color: #fff; font-family: var(--ui); isolation: isolate; --ky-red: #ff3b30; --ky-blue: #0a84ff; --ky-orange: #ff9f0a; --ky-green: #30d158; --ky-purple: #bf5af2; --ky-bg: #f2f2f7; --ky-card: #fff; --ky-ink: #1c1c1e; --ky-mute: #6e6e73; --ky-line: rgb(60 60 67 / .18); --ky-mute-2: rgb(3 3 2 / .64); --ky-field: #fff; --ky-glass: rgb(255 255 255 / .92); }
  .ph-screen.is-dark { --ky-bg: #1c1c1e; --ky-card: #2c2c2e; --ky-ink: #f2f2f7; --ky-mute: #aeaeb2; --ky-line: rgb(84 84 88 / .5); --ky-mute-2: rgb(255 255 255 / .72); --ky-field: #2c2c2e; --ky-glass: rgb(44 44 46 / .94); }
  @supports (corner-shape: squircle) { .ph-screen { corner-shape: squircle; } }
  .ph-screen.is-light.on-work .ph-status { color: #1c1c1e; }
  .ph-screen.is-light.on-work .ph-icons i { background: #1c1c1e; }
  .ph-screen.is-light.on-work .bat { box-shadow: inset 0 0 0 1.5px rgb(28 28 30 / .5); background: linear-gradient(90deg, #1c1c1e 0 80%, transparent 80%); background-clip: content-box; }
  .ph-status { position: absolute; top: 14px; left: 0; right: 0; display: flex; justify-content: space-between; padding: 0 30px; font-size: 14px; font-weight: 600; z-index: 6; letter-spacing: -.01em; pointer-events: none; }
  .ph-icons { display: inline-flex; gap: 5px; align-items: center; }
  .ph-icons i { display: inline-block; background: #fff; }
  .sig { width: 15px; height: 10px; -webkit-mask: linear-gradient(90deg, #000 0 20%, transparent 20% 27%, #000 27% 47%, transparent 47% 54%, #000 54% 74%, transparent 74% 81%, #000 81%); mask: linear-gradient(90deg, #000 0 20%, transparent 20% 27%, #000 27% 47%, transparent 47% 54%, #000 54% 74%, transparent 74% 81%, #000 81%); clip-path: polygon(0 60%, 100% 0, 100% 100%, 0 100%); }
  .wifi { width: 14px; height: 10px; border-radius: 50% 50% 0 0; }
  .bat { width: 24px; height: 11px; border-radius: 3.5px; box-shadow: inset 0 0 0 1.5px rgb(255 255 255 / .5); background: linear-gradient(90deg, #fff 0 80%, transparent 80%); background-clip: content-box; padding: 2px; }
  .island { position: absolute; top: 11px; left: 50%; width: 96px; height: 28px; margin-left: -48px; border-radius: 999px; background: #000; z-index: 7; }
  /* the home indicator, on the glass the way iOS draws it */
  .ph-home { position: absolute; bottom: 8px; left: 50%; width: 134px; height: 5px; margin-left: -67px; border-radius: 3px; background: rgb(28 28 30 / .35); z-index: 8; pointer-events: none; }
  .ph-screen.is-dark .ph-home, .ph-screen:not(.on-work) .ph-home { background: rgb(255 255 255 / .45); }
  .ph-screen.is-light.on-work .ph-home { background: rgb(28 28 30 / .35); }

  /* the alias sits apart so the CSS minifier keeps both properties */
  .ky-tabs { -webkit-backdrop-filter: var(--bf); }

  .ky-page { position: absolute; inset: 0; display: grid; grid-template-rows: auto minmax(0, 1fr); }
  /* the timeline dissolves into the chin under the glass bar instead of being
     cut through the middle of a row at the screen's edge */
  .ky-page::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 62px; z-index: 4;
    background: linear-gradient(to top, var(--ky-bg) 30%, transparent);
    pointer-events: none;
  }
  .ky-work::after { background: linear-gradient(to top, var(--ky-bg), transparent); }
  .ky-page[hidden] { display: none; }
  .ky-hero { position: relative; padding: 54px 18px 0; background: #0e0e12; }
  .ky-day { display: flex; align-items: flex-start; gap: 4px; }
  .ky-dayname { font-size: 44px; font-weight: 800; letter-spacing: -0.04em; line-height: 1; }
  .ky-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--ky-red); margin-top: 6px; }
  .ky-dot.is-off { opacity: 0; }
  .ky-face { margin-left: auto; min-width: 44px; min-height: 44px; padding: 0 6px; font-size: 14px; color: rgb(255 255 255 / .85); letter-spacing: -.02em; white-space: nowrap; border-radius: 12px; transition: transform var(--t-fast) var(--soft), background-color var(--t-fast) var(--soft); font-family: var(--ui); }
  .ky-face:hover { background: rgb(255 255 255 / .06); }
  .ky-face:active { transform: scale(.92); }
  .ky-next { margin-top: 10px; font-size: 13px; line-height: 1.35; color: rgb(255 255 255 / .62); min-height: 36px; }
  .ky-next b { color: #fff; font-weight: 600; }
  .ky-week { display: grid; grid-template-columns: repeat(7, 1fr); margin: 10px -6px 0; }
  .ky-week li { display: contents; }
  .ky-week button { display: grid; justify-items: center; gap: 3px; padding: 8px 0 9px; border-radius: 14px; font-size: 10px; color: rgb(255 255 255 / .55); font-family: var(--ui); transition: background-color var(--t-fast) var(--soft), transform var(--t-fast) var(--soft); min-height: 44px; }
  .ky-week button:active { transform: scale(.95); }
  .ky-week b { font-size: 13px; color: #fff; font-weight: 600; }
  .ky-week i { width: 4px; height: 4px; border-radius: 50%; background: transparent; }
  .ky-week .has i { background: rgb(255 255 255 / .45); }
  .ky-week .is-today b { color: var(--ky-red); }
  .ky-week .is-on { background: rgb(255 255 255 / .08); box-shadow: inset 0 0 0 1px rgb(255 255 255 / .18); }
  /* a sentence under the day strip, left-aligned with it, rather than a 10px
     letterspaced uppercase label floating above the headline */
  .ky-demo { padding: 8px 0 12px; font-size: 13px; line-height: 1.35; color: rgb(255 255 255 / .62); }

  .ky-curtain { position: relative; margin-top: 10px; background: var(--ky-bg); color: var(--ky-ink); border-radius: 26px 26px 0 0; overflow-y: auto; overflow-x: clip; overscroll-behavior: contain; padding: 14px 12px 108px; min-height: 0; }
  .ky-tl { display: grid; gap: 0; }
  /* one hairline-with-a-label on the screen, not three: the section label is a
     plain sentence-case line and only the divider under Anytime draws a rule */
  .ky-band { display: flex; align-items: center; gap: 8px; padding: 2px 0 6px 46px; font-size: 13px; font-weight: 500; color: var(--ky-mute); }
  .ky-band.is-solid { padding: 0 0 8px 46px; }
  .ky-band.is-solid::after { content: ''; flex: 1; border-top: 1px solid var(--ky-line); }
  .ky-row-w { display: grid; grid-template-columns: 46px minmax(0, 1fr); align-items: stretch; }
  .ky-clock { font-size: 11px; color: var(--ky-mute); padding-top: 9px; padding-right: 4px; text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .ky-clock small { font-size: 8px; }
  .ky-item { position: relative; display: grid; grid-template-columns: 18px minmax(0, 1fr); gap: 8px; align-items: start; padding: 7px 8px 7px 6px; border-radius: 12px; min-height: var(--kh, 40px); text-align: left; font-family: var(--ui); color: inherit; width: 100%; transition: transform var(--t-fast) var(--soft), background-color .2s var(--soft), opacity .3s var(--soft); touch-action: manipulation; -webkit-user-select: none; user-select: none; }
  .ky-item:active { transform: scale(.98); }
  .ky-item.is-held { transform: scale(.97); background: rgb(0 0 0 / .05); }
  .ky-row-w.is-nested { padding-left: 14px; }
  .ky-row-w.is-nested .ky-clock { visibility: hidden; }
  .ky-row-w.is-nested .ky-item { box-shadow: inset 2px 0 0 rgb(10 132 255 / .35); border-radius: 0 12px 12px 0; }
  .ky-mark { width: 16px; height: 16px; border-radius: 50%; margin-top: 2px; box-shadow: inset 0 0 0 2px var(--ky-orange); transition: background-color .15s var(--soft); position: relative; }
  .ky-item.is-done .ky-mark { background: var(--ky-orange); }
  .ky-item.is-done .ky-mark::after { content: ''; position: absolute; left: 5px; top: 2px; width: 4px; height: 8px; border: solid #fff; border-width: 0 2px 2px 0; transform: rotate(45deg); }
  .ky-item.is-done .ky-title { text-decoration: line-through; color: var(--ky-mute); }
  .ky-item.is-event .ky-mark { border-radius: 3px; background: var(--ky-blue); box-shadow: none; width: 4px; height: calc(100% - 4px); min-height: 24px; margin-left: 6px; }
  .ky-item.is-event { background: rgb(10 132 255 / .09); }
  .ky-body { display: grid; line-height: 1.25; min-width: 0; }
  .ky-title { font-size: 13.5px; font-weight: 600; overflow-wrap: anywhere; }
  .ky-sub { font-size: 11px; color: var(--ky-mute); display: flex; flex-wrap: wrap; gap: 4px 8px; }
  .ky-sub .tg { color: var(--tg, var(--ky-purple)); }
  /* a free block is plain right-aligned text, with no rule running through it */
  .ky-gap { display: grid; grid-template-columns: 46px 1fr; align-items: center; height: 26px; }
  .ky-gap span { grid-column: 2; grid-row: 1; justify-self: end; font-size: 12px; color: var(--ky-mute-2); padding: 0 10px 0 8px; }
  .ky-gap i { display: none; }
  .ky-now { display: grid; grid-template-columns: 46px 1fr; align-items: center; height: 10px; margin: -5px 0; position: relative; z-index: 2; pointer-events: none; }
  .ky-now i { grid-column: 2; height: 2px; background: var(--ky-red); border-radius: 2px; position: relative; }
  .ky-now i::before { content: ''; position: absolute; left: -4px; top: -3px; width: 8px; height: 8px; border-radius: 50%; background: var(--ky-red); }
  .ky-empty { display: grid; justify-items: center; gap: 8px; padding: 36px 16px; color: var(--ky-mute); font-size: 13px; text-align: center; }
  .ky-empty b { font-size: 22px; font-weight: 500; color: var(--ky-ink); }

  .ky-work { background: var(--ky-bg); color: var(--ky-ink); }
  .ky-work-head { display: flex; align-items: baseline; justify-content: space-between; padding: 58px 18px 8px; }
  .ky-work-head h2 { font-size: 30px; font-weight: 800; letter-spacing: -.03em; }
  .ky-work-head span { font-size: 12px; color: var(--ky-mute); }
  .ky-work-list { overflow-y: auto; padding: 0 12px 96px; display: grid; gap: 14px; align-content: start; }
  .ky-sec { display: grid; gap: 2px; }
  .ky-sec-h { display: flex; align-items: center; gap: 8px; padding: 4px 6px; font-size: 11px; color: var(--ky-mute); text-transform: uppercase; letter-spacing: .05em; }
  .ky-sec-h .tg { color: var(--tg); text-transform: none; letter-spacing: 0; font-size: 12px; font-weight: 600; }
  .ky-sec .ky-item { background: var(--ky-card); }
  .ky-sec .ky-item + .ky-item { margin-top: 3px; }

  /* the glass bar */
  .ky-bar { position: absolute; left: 12px; right: 12px; bottom: 24px; display: flex; gap: 8px; align-items: center; z-index: 5; }
  .ky-tabs { position: relative; flex: 1; display: grid; grid-template-columns: repeat(3, 1fr); padding: 4px; border-radius: 999px; background: var(--ky-glass); --bf: blur(24px) saturate(180%); backdrop-filter: var(--bf); box-shadow: 0 1px 0 rgb(255 255 255 / .35) inset, 0 8px 24px -10px rgb(0 0 0 / .45), 0 0 0 .5px rgb(0 0 0 / .08); }
  .ky-pill { position: absolute; top: 4px; bottom: 4px; left: 4px; width: calc((100% - 8px) / 3); border-radius: 999px; background: rgb(0 0 0 / .08); transition: transform .35s var(--out); }
  .ph-screen.is-dark .ky-pill { background: rgb(255 255 255 / .12); }
  .ky-tab { position: relative; display: grid; justify-items: center; gap: 1px; min-height: 44px; padding: 5px 0 4px; border-radius: 999px; font-size: 10px; font-weight: 600; color: var(--ky-mute); font-family: var(--ui); transition: color var(--t-fast) var(--soft), transform var(--t-fast) var(--soft); }
  .ky-tab:active { transform: scale(.96); }
  .ky-tab svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .ky-tab.is-on { color: var(--ky-red); }
  .ky-plus { width: 52px; height: 52px; border-radius: 50%; background: var(--ky-red); color: #fff; display: grid; place-items: center; box-shadow: 0 8px 20px -8px rgb(255 59 48 / .8); transition: transform var(--t-fast) var(--soft); flex: none; }
  .ky-plus svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; }
  .ky-plus:active { transform: scale(.92); }
  .ky-plus.is-bounce { animation: kybounce .35s var(--out); }
  @keyframes kybounce { 40% { transform: scale(1.12); } }

  /* sheets */
  .ky-veil { position: absolute; inset: 0; background: rgb(0 0 0 / .3); z-index: 8; opacity: 0; transition: opacity .25s var(--soft); }
  .ky-veil.is-on { opacity: 1; }
  .ky-veil[hidden] { display: none; }
  .ky-sheet { position: absolute; left: 0; right: 0; bottom: 0; z-index: 9; background: var(--ky-bg); color: var(--ky-ink); border-radius: 22px 22px 0 0; padding: 14px 14px 18px; transform: translateY(105%); transition: transform .38s var(--out); box-shadow: 0 -10px 40px -20px rgb(0 0 0 / .5); max-height: 92%; overflow-y: auto; overscroll-behavior: contain; }
  .ky-sheet.is-on { transform: none; }
  .ky-sheet[hidden] { display: none; }
  .ky-sheet-top { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; margin: -4px 0 10px; font-size: 15px; }
  .ky-sheet-top b { font-weight: 600; }
  .ky-link { justify-self: start; font-size: 15px; color: var(--ky-blue); min-height: 44px; padding: 0 4px; font-family: var(--ui); }
  .ky-link.is-bold { justify-self: end; font-weight: 600; }
  .ky-field { position: relative; display: flex; align-items: center; min-height: 46px; padding: 0 4px 0 14px; border-radius: 14px; background: var(--ky-field); box-shadow: 0 1px 2px rgb(0 0 0 / .08); font-size: 15px; }
  .ky-field.is-shake { animation: kyshake .4s var(--soft); }
  @keyframes kyshake { 20% { transform: translateX(-6px); } 40% { transform: translateX(6px); } 60% { transform: translateX(-4px); } 80% { transform: translateX(4px); } }
  .ky-paint { position: absolute; left: 14px; right: 50px; top: 50%; translate: 0 -50%; white-space: pre; overflow: hidden; pointer-events: none; font: inherit; color: transparent; }
  .ky-paint .tk { border-radius: 4px; }
  .tk-when { background: rgb(255 59 48 / .28); } .tk-time { background: rgb(10 132 255 / .28); } .tk-rep { background: rgb(48 209 88 / .32); } .tk-tag { background: rgb(191 90 242 / .3); } .tk-place { background: rgb(255 159 10 / .32); } .tk-alert { background: rgb(255 214 10 / .4); } .tk-pri { background: rgb(255 69 58 / .32); } .tk-note { background: rgb(120 120 128 / .26); }
  .ky-real { flex: 1; min-width: 0; height: 46px; background: transparent; border: 0; font: inherit; color: inherit; outline: none; caret-color: var(--ky-red); padding: 0; }
  .ky-real::placeholder { color: var(--ky-mute); }
  .ky-send { width: 38px; height: 38px; border-radius: 50%; background: var(--ky-red); color: #fff; display: grid; place-items: center; transition: transform var(--t-fast) var(--soft), opacity var(--t-fast) var(--soft); }
  .ky-send svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .ky-send:active { transform: scale(.9); }
  .ky-read { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 8px; min-height: 22px; font-size: 10.5px; color: var(--ky-mute); }
  .ky-read span { padding: 3px 7px; border-radius: 6px; background: var(--ky-card); box-shadow: 0 1px 2px rgb(0 0 0 / .06); }
  .ky-read span.is-blank { background: transparent; box-shadow: none; padding-left: 2px; }
  .ky-chips { display: flex; align-items: center; gap: 6px; margin-top: 8px; flex-wrap: wrap; }
