---
/* Safari: two tabs. One holds petermei.com, the small real website under
   /site, in a same-origin frame at 1:1. The other holds the real
   www.volbase.app in a frame at 1:1, with the old captured film underneath as
   the fallback for any browser or origin the live site refuses. The toolbar
   in the window's title bar (back, forward, the URL field, reload, share)
   lives in desk.ts and talks to the script in scripts/scenes/volbase.ts. */
const pins = [
  { x: 36, y: 58, d: '1.4 mi', name: 'the school Institute of Science · docent' },
  { x: 68, y: 30, d: '2.9 mi', name: 'Gleaners Food Bank · sort shift' },
  { x: 52, y: 44, d: '3.0 mi', name: "Children's hospital · patient support" },
  { x: 24, y: 34, d: '4.1 mi', name: 'Detroit Zoo · summer program' },
  { x: 78, y: 66, d: '6.7 mi', name: 'Michigan Science Center · camp lead' },
];
---
<div class="safari" data-vb data-sf-tab="volbase">
  <div class="sf-bar" data-drag>
    <div class="sf-tabs" role="tablist" aria-label="Tabs">
      <button class="sf-tab" type="button" role="tab" aria-selected="false" data-sf-pick="site">
        <img src="/icons/favicon.svg" width="14" height="14" alt="" />
        <span data-sf-title="site">petermei.com</span>
      </button>
      <button class="sf-tab is-on" type="button" role="tab" aria-selected="true" data-sf-pick="volbase">
        <img src="/img/volbase-icon.svg" width="14" height="14" alt="" />
        <span data-sf-title="volbase">volbase</span>
      </button>
    </div>
    <span class="sf-demo" data-vb-demo hidden>demo</span>
  </div>
  <div class="sf-page">
    <!-- tab one: petermei.com, the site under /site, same origin -->
    <div class="sf-pane" data-sf-pane="site" hidden>
      <iframe class="sf-frame" data-sf-frame="site" title="petermei.com" referrerpolicy="same-origin"></iframe>
    </div>

    <!-- tab two: the real volbase, or the film -->
    <div class="sf-pane" data-sf-pane="volbase">
      <iframe class="sf-frame" data-sf-frame="volbase" title="volbase" allow="geolocation" referrerpolicy="strict-origin-when-cross-origin"></iframe>
      <img class="sf-still" data-vb-still src="/img/volbase-landing.webp" width="1280" height="2400" alt="" decoding="async" />
      <div class="sf-film" data-vb-film hidden>
        <div class="vb-tabs" role="group" aria-label="Demo pages">
          <button class="vb-tab is-on" type="button" data-vb-tab="landing">volbase.app</button>
          <button class="vb-tab" type="button" data-vb-tab="map">Opportunities near you</button>
        </div>
        <div class="vb-landing" data-vb-view="landing">
          <img class="vb-shot vb-shot-wide" src="/img/volbase-landing.webp" width="1280" height="2400" alt="The volbase.app landing page, captured" loading="lazy" decoding="async" data-vb-shot />
          <img class="vb-shot vb-shot-hand" src="/img/volbase-landing-m.webp" width="390" height="1740" alt="The volbase.app landing page, captured on a phone" loading="lazy" decoding="async" data-vb-shot-m />
        </div>
        <div class="vb-map" data-vb-view="map" aria-hidden="true">
          <svg class="vb-roads" viewBox="0 0 960 520" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0 140 C 180 120, 320 180, 520 150 S 820 90, 960 130" /><path d="M0 300 C 200 280, 380 340, 600 300 S 860 260, 960 290" />
            <path d="M0 430 C 160 450, 400 400, 620 440 S 900 470, 960 430" /><path d="M140 0 C 160 160, 120 320, 170 520" /><path d="M420 0 C 400 180, 460 340, 430 520" />
            <path d="M700 0 C 690 200, 740 360, 720 520" /><path d="M860 0 C 880 160, 840 380, 870 520" />
          </svg>
          <div class="vb-you" aria-hidden="true"><span></span></div>
          <ul class="vb-pins" aria-label="Nearest opportunities">
            {pins.map((p, i) => (<li class="vb-pin" style={`--x:${p.x}%;--y:${p.y}%;--i:${i}`} data-vb-pin><span class="pin-head"></span><span class="pin-lbl">{p.d}</span></li>))}
          </ul>
          <ol class="vb-list" data-vb-list>
            {pins.map((p, i) => (<li class="vb-card" style={`--i:${i}`}><b class="num">{p.d}</b><span>{p.name}</span></li>))}
          </ol>
          <div class="vb-sort" data-vb-sort>sorted <b>nearest first</b></div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .safari { position: absolute; inset: 0; display: grid; grid-template-rows: 34px 1fr; background: #f6f3ee; color: #2b2622; font-family: var(--ui); }
  .sf-bar { display: flex; align-items: center; gap: 8px; padding: 0 8px; background: #ebe7e1; box-shadow: 0 .5px 0 rgb(0 0 0 / .14); }
  .sf-tabs { display: flex; gap: 1px; flex: 1; min-width: 0; height: 26px; }
  .sf-tab { position: relative; display: inline-flex; align-items: center; gap: 7px; flex: 1; min-width: 0; padding: 0 12px; border-radius: 7px; font-size: 12px; color: #6b655e; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; transition: background-color var(--t-fast) var(--soft), color var(--t-fast) var(--soft); cursor: default; justify-content: center; }
  .sf-tab span { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .sf-tab::before { content: ''; position: absolute; left: 0; right: 0; top: 50%; translate: 0 -50%; height: 44px; }
  .sf-tab:active { transform: scale(.98); }
  .sf-tab img { border-radius: 3px; flex: none; }
  .sf-tab.is-on { background: #fbfaf7; color: #2b2622; box-shadow: 0 1px 2px rgb(0 0 0 / .12), 0 0 0 .5px rgb(0 0 0 / .08); }
  .sf-tab:hover:not(.is-on) { background: rgb(0 0 0 / .05); }
  .sf-demo { flex: none; font-size: 10px; letter-spacing: .06em; text-transform: uppercase; color: #5f5952; padding: 2px 7px; border-radius: 4px; box-shadow: inset 0 0 0 .5px rgb(0 0 0 / .18); }
  .sf-page { position: relative; overflow: clip; }
  .sf-pane { position: absolute; inset: 0; }
  .sf-frame { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; background: #f6f3ee; }
  [data-sf-pane='site'] .sf-frame { background: var(--surface); }
  /* the captured first frame sits over the live frame until it answers */
  .sf-still { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top; transition: opacity var(--t-fast) var(--soft); }
  .sf-still.is-gone { opacity: 0; pointer-events: none; }
  /* the film keeps the old figure's own pixels and is scaled to the pane */
  .sf-film { position: absolute; left: 50%; top: 50%; width: 1060px; height: 606px; transform: translate(-50%, -50%) scale(var(--s, 1)); overflow: clip; background: #f6f3ee; }
  .vb-tabs { position: absolute; right: 14px; bottom: 14px; z-index: 3; display: inline-flex; gap: 2px; padding: 2px; border-radius: 8px; background: rgb(255 255 255 / .85); box-shadow: 0 1px 2px rgb(0 0 0 / .12), 0 0 0 .5px rgb(0 0 0 / .08); backdrop-filter: blur(8px); }
  .vb-tab { padding: 4px 10px; border-radius: 6px; font-size: 11px; color: #6b655e; transition: background-color var(--t-fast) var(--soft); }
  .vb-tab.is-on { background: #2b2622; color: #fff; }
  .vb-tab:active { transform: scale(.98); }
  .vb-landing { position: absolute; inset: 0; will-change: transform; transition: opacity var(--t-fast) var(--soft); }
  .vb-shot { width: 100%; height: auto; transform: translateY(var(--vb-scroll, 0px)); will-change: transform; }
  .vb-shot-hand { display: none; }
  :global(.is-narrow) .vb-shot-wide { display: none; }
  :global(.is-narrow) .vb-shot-hand { display: block; }

  .vb-map { position: absolute; inset: 0; background: #ece9e2; opacity: 0; pointer-events: none; transition: opacity var(--t-fast) var(--soft); }
  .vb-map.is-on { opacity: 1; pointer-events: auto; }
  .vb-roads { position: absolute; inset: 0; width: 100%; height: 100%; }
  .vb-roads path { fill: none; stroke: #fff; stroke-width: 10; stroke-linecap: round; }
  .vb-you { position: absolute; left: 47%; top: 50%; width: 18px; height: 18px; margin: -9px; border-radius: 50%; background: #5c79b8; border: 3px solid #fff; box-shadow: 0 0 0 6px rgb(92 121 184 / .18); }
  .vb-pin { position: absolute; left: var(--x); top: var(--y); transform: translate(-50%, -100%) translateY(-24px) scale(.6); opacity: 0; display: grid; justify-items: center; gap: 4px; }
  .vb-pin.is-in { transform: translate(-50%, -100%); opacity: 1; transition: transform .45s var(--out), opacity .25s var(--soft); transition-delay: calc(var(--i) * 90ms); }
  .pin-head { width: 22px; height: 22px; border-radius: 50% 50% 50% 0; transform: rotate(-45deg); background: #5c79b8; box-shadow: 0 6px 12px -4px rgb(0 0 0 / .4), inset 0 0 0 5px #fff; }
  .pin-lbl { font-size: 10px; font-weight: 600; background: #fff; padding: 2px 6px; border-radius: 6px; box-shadow: 0 1px 2px rgb(0 0 0 / .12); color: #2b2622; }
  .vb-list { position: absolute; left: 14px; top: 14px; width: 250px; display: grid; gap: 8px; }
  .vb-card { display: grid; grid-template-columns: 48px 1fr; gap: 10px; align-items: center; padding: 10px 12px; background: #fff; border-radius: 12px; box-shadow: 0 1px 2px rgb(0 0 0 / .08), 0 8px 20px -14px rgb(0 0 0 / .3); font-size: 12px; line-height: 1.3; opacity: 0; transform: translateY(10px); }
  .vb-card.is-in { opacity: 1; transform: none; transition: opacity .4s var(--soft), transform .5s var(--out); transition-delay: calc(var(--i) * 80ms + 150ms); }
  .vb-card b { color: #4b68c3; font-weight: 700; font-size: 12px; }
  .vb-sort { position: absolute; right: 14px; top: 44px; font-size: 11px; padding: 6px 10px; border-radius: 999px; background: #fff; box-shadow: 0 1px 2px rgb(0 0 0 / .1); color: #4b4640; opacity: 0; transform: translateY(6px); }
  .vb-sort.is-in { opacity: 1; transform: none; transition: opacity .4s var(--out) .6s, transform .4s var(--out) .6s; }
  .vb-sort b { color: #4b68c3; }
  :global(.is-narrow) .sf-tab { padding: 0 8px; font-size: 11px; }
  :global(.is-narrow) .vb-list { width: 160px; }
  :global(.is-narrow) .vb-card { grid-template-columns: 40px 1fr; padding: 7px 9px; font-size: 10.5px; }
  :global(.is-narrow) .vb-sort { display: none; }
</style>
