---
/* volbase in a Safari window: the real landing page scrolls inside, then the
   tab switches to the opportunities map and pins drop nearest-first. */
const pins = [
  { x: 52, y: 44, d: '0.8 mi', name: 'Henry Ford Hospital · patient support' },
  { x: 36, y: 58, d: '1.4 mi', name: 'the school Institute of Science · docent' },
  { x: 68, y: 30, d: '2.9 mi', name: 'Gleaners Food Bank · sort shift' },
  { x: 24, y: 34, d: '4.1 mi', name: 'Detroit Zoo · summer program' },
  { x: 78, y: 66, d: '6.7 mi', name: 'Michigan Science Center · camp lead' },
];
---
<div class="safari" data-vb>
  <div class="sf-bar">
    <div class="lights" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="sf-tabs">
      <button class="sf-tab is-on" type="button" data-vb-tab="landing"><img src="/img/volbase-icon.svg" width="14" height="14" alt="" />volbase.app</button>
      <button class="sf-tab" type="button" data-vb-tab="map"><img src="/img/volbase-icon.svg" width="14" height="14" alt="" />Opportunities near you</button>
    </div>
    <div class="sf-url mono"><svg width="10" height="12" viewBox="0 0 10 12" aria-hidden="true"><rect x="1" y="5" width="8" height="6.5" rx="1.5" fill="currentColor"/><path d="M3 5V3.5a2 2 0 0 1 4 0V5" fill="none" stroke="currentColor" stroke-width="1.3"/></svg><span data-vb-url>volbase.app</span></div>
  </div>
  <div class="sf-page">
    <div class="vb-landing" data-vb-view="landing">
      <img class="vb-shot" src="/img/volbase-landing.webp" width="1280" height="2400" alt="The live volbase.app landing page" loading="lazy" decoding="async" data-vb-shot />
    </div>
    <div class="vb-map" data-vb-view="map" aria-hidden="true">
      <svg class="vb-roads" viewBox="0 0 960 520" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 140 C 180 120, 320 180, 520 150 S 820 90, 960 130" /><path d="M0 300 C 200 280, 380 340, 600 300 S 860 260, 960 290" />
        <path d="M0 430 C 160 450, 400 400, 620 440 S 900 470, 960 430" /><path d="M140 0 C 160 160, 120 320, 170 520" /><path d="M420 0 C 400 180, 460 340, 430 520" />
        <path d="M700 0 C 690 200, 740 360, 720 520" /><path d="M860 0 C 880 160, 840 380, 870 520" />
      </svg>
      <div class="vb-you" aria-hidden="true"><span></span></div>
      <ul class="vb-pins" aria-label="Nearest opportunities">
        {pins.map((p, i) => (<li class="vb-pin" style={`--x:${p.x}%;--y:${p.y}%;--i:${i}`} data-vb-pin><span class="pin-head"></span><span class="pin-lbl">{p.d}</span></li>))}
      </ul>
      <ol class="vb-list" data-vb-list>
        {pins.map((p, i) => (<li class="vb-card" style={`--i:${i}`}><b class="num">{p.d}</b><span>{p.name}</span></li>))}
      </ol>
      <div class="vb-sort mono" data-vb-sort>sorted <b>nearest first</b></div>
    </div>
  </div>
</div>

<style>
  .safari { position: absolute; inset: 0; display: grid; grid-template-rows: 52px 1fr; background: #f6f3ee; color: #2b2622; font-family: var(--ui); }
  .sf-bar { display: grid; grid-template-columns: 62px 1fr 260px; align-items: center; gap: 12px; padding: 0 12px; background: linear-gradient(#fbfaf7, #efece6); border-bottom: .5px solid rgb(0 0 0 / .14); }
  .lights { display: flex; gap: 8px; }
  .lights i { width: 12px; height: 12px; border-radius: 50%; box-shadow: inset 0 0 0 .5px rgb(0 0 0 / .18); }
  .lights i:nth-child(1) { background: #ff5f57; } .lights i:nth-child(2) { background: #febc2e; } .lights i:nth-child(3) { background: #28c840; }
  .sf-tabs { display: flex; gap: 6px; min-width: 0; }
  .sf-tab { display: inline-flex; align-items: center; gap: 7px; height: 30px; padding: 0 12px; border-radius: 8px; font-size: 12px; color: #6b655e; white-space: nowrap; transition: background-color var(--t-fast) var(--settle), color var(--t-fast) var(--settle); }
  .sf-tab img { border-radius: 3px; }
  .sf-tab.is-on { background: #fff; color: #2b2622; box-shadow: 0 1px 2px rgb(0 0 0 / .12), 0 0 0 .5px rgb(0 0 0 / .08); }
  .sf-url { display: flex; align-items: center; justify-content: center; gap: 6px; height: 30px; border-radius: 8px; background: rgb(0 0 0 / .05); font-size: 12px; color: #4b4640; }
  .sf-page { position: relative; overflow: clip; }
  .vb-landing { position: absolute; inset: 0; will-change: transform; }
  .vb-shot { width: 100%; height: auto; transform: translateY(var(--vb-scroll, 0px)); will-change: transform; }

  .vb-map { position: absolute; inset: 0; background: #ece9e2; opacity: 0; pointer-events: none; }
  .vb-map.is-on { opacity: 1; pointer-events: auto; }
  .vb-roads { position: absolute; inset: 0; width: 100%; height: 100%; }
  .vb-roads path { fill: none; stroke: #fff; stroke-width: 10; stroke-linecap: round; }
  .vb-you { position: absolute; left: 47%; top: 50%; width: 18px; height: 18px; margin: -9px; border-radius: 50%; background: #5c79b8; border: 3px solid #fff; box-shadow: 0 0 0 0 rgb(92 121 184 / .5); animation: youpulse 2.2s var(--out-quart) infinite; }
  @keyframes youpulse { 70% { box-shadow: 0 0 0 16px transparent; } 100% { box-shadow: 0 0 0 0 transparent; } }
  .vb-pin { position: absolute; left: var(--x); top: var(--y); transform: translate(-50%, -100%) translateY(-24px) scale(.6); opacity: 0; display: grid; justify-items: center; gap: 4px; }
  .vb-pin.is-in { transform: translate(-50%, -100%); opacity: 1; transition: transform .55s var(--boing), opacity .25s var(--settle); transition-delay: calc(var(--i) * 110ms); }
  .pin-head { width: 22px; height: 22px; border-radius: 50% 50% 50% 0; transform: rotate(-45deg); background: #5c79b8; box-shadow: 0 6px 12px -4px rgb(0 0 0 / .4), inset 0 0 0 5px #fff; }
  .pin-lbl { font-size: 10px; font-weight: 600; background: #fff; padding: 2px 6px; border-radius: 6px; box-shadow: 0 1px 2px rgb(0 0 0 / .12); color: #2b2622; }
  .vb-list { position: absolute; left: 14px; top: 14px; width: 250px; display: grid; gap: 8px; }
  .vb-card { display: grid; grid-template-columns: 48px 1fr; gap: 10px; align-items: center; padding: 10px 12px; background: #fff; border-radius: 12px; box-shadow: 0 1px 2px rgb(0 0 0 / .08), 0 8px 20px -14px rgb(0 0 0 / .3); font-size: 12px; line-height: 1.3; opacity: 0; transform: translateY(10px); }
  .vb-card.is-in { opacity: 1; transform: none; transition: opacity .4s var(--settle), transform .5s var(--out-quart); transition-delay: calc(var(--i) * 90ms + 200ms); }
  .vb-card b { color: #5c79b8; font-weight: 700; font-size: 12px; }
  .vb-sort { position: absolute; right: 14px; top: 14px; font-size: 11px; padding: 6px 10px; border-radius: 999px; background: #fff; box-shadow: 0 1px 2px rgb(0 0 0 / .1); color: #4b4640; opacity: 0; transform: translateY(6px); }
  .vb-sort.is-in { opacity: 1; transform: none; transition: all .4s var(--out-quart) .7s; }
  .vb-sort b { color: #5c79b8; }
  .is-narrow .sf-bar { grid-template-columns: 62px 1fr; gap: 8px; }
  .is-narrow .sf-url { display: none; }
  .is-narrow .sf-tab { padding: 0 8px; font-size: 11px; }
  .is-narrow .vb-list { width: 160px; }
  .is-narrow .vb-card { grid-template-columns: 40px 1fr; padding: 7px 9px; font-size: 10.5px; }
  .is-narrow .vb-sort { display: none; }
</style>
