---
/* Rin: the panel that drops out of the menu bar, the way the real app's
   does. A tab bar with a status dot per session, a plus for a new one, and
   the terminal under it. The assistant inside answers from a small scripted
   set written in her voice, and a few of the things she can do reach the
   desktop itself: opening an app, switching the appearance, putting the Mac
   to sleep. The strip under the prompt lists what she knows, so nobody
   types into a void. Nothing here is live and nothing typed leaves the page.
   The script is scripts/scenes/rin.ts; the tabs and what was said in each
   are kept for the tab session. */
---
<div class="rin" data-rin>
  <div class="rin-bar">
    <span class="rin-face" data-rin-face>(｡•ᴗ•｡)</span>
    <b class="rin-app">Rin</b>
    <span class="rin-right mono"><i class="rin-light" data-rin-light></i>Rin</span>
  </div>
  <div class="rin-panel" data-rin-panel>
    <div class="rin-tabs" role="tablist" aria-label="Sessions" data-rin-tabs></div>
    <div class="term mono" data-term role="log" aria-label="A demo terminal. Type help, or pick a line below.">
      <div class="term-out" data-term-out></div>
      <div class="term-line"><span class="term-ps">❯</span><span class="term-in" data-term-in></span><span class="caret" data-term-caret aria-hidden="true"></span></div>
      <input class="sr term-real" data-sim-input data-term-real aria-label="Demo terminal input" autocomplete="off" autocapitalize="off" spellcheck="false" />
    </div>
    <div class="rin-try" data-rin-try aria-label="Things Rin can answer">
      <span class="rin-try-lbl">try</span>
      <span class="rin-try-list" data-rin-try-list></span>
      <span class="rin-demo mono">demo</span>
    </div>
  </div>
</div>

<style is:global>
  .rin { position: absolute; inset: 0; display: grid; grid-template-rows: 28px minmax(0, 1fr); background: var(--slate); color: var(--slate-fg); }
  .rin-bar { display: flex; align-items: center; gap: 14px; padding: 0 12px; background: var(--slate-2); font-size: 12px; box-shadow: 0 .5px 0 rgb(255 255 255 / .08); position: relative; z-index: 2; }
  .rin-face { font-size: 12px; letter-spacing: -0.04em; }
  .rin-app { font-weight: 700; }
  .rin-right { margin-left: auto; display: inline-flex; align-items: center; gap: 8px; font-size: 11px; color: rgb(221 224 229 / .8); }
  .rin-light { width: 7px; height: 7px; border-radius: 50%; background: #7ee787; box-shadow: 0 0 6px #7ee787; transition: background-color .3s, box-shadow .3s; }
  .rin-light.is-amber { background: #f7be00; box-shadow: 0 0 6px #f7be00; }
  .rin-panel { grid-row: 2; display: grid; grid-template-rows: 34px minmax(0, 1fr) 34px; background: var(--slate); min-height: 0; }
  .rin-tabs { display: flex; align-items: center; gap: 4px; padding: 0 8px; box-shadow: 0 .5px 0 rgb(255 255 255 / .08); font-size: 11.5px; overflow-x: auto; scrollbar-width: none; }
  .rin-tab { position: relative; display: inline-flex; align-items: center; gap: 6px; height: 26px; padding: 0 8px 0 10px; border-radius: 7px; color: rgb(221 224 229 / .6); font: inherit; font-family: var(--ui); white-space: nowrap; transition: background-color var(--t-fast) var(--soft), color var(--t-fast) var(--soft); }
  .rin-tab::before { content: ''; position: absolute; left: 0; right: 0; top: 50%; translate: 0 -50%; height: 44px; }
  .rin-tab:hover { background: rgb(255 255 255 / .05); }
  .rin-tab i { width: 6px; height: 6px; border-radius: 50%; background: rgb(221 224 229 / .35); }
  .rin-tab.is-on { background: rgb(255 255 255 / .09); color: var(--slate-fg); }
  .rin-tab.is-on i { background: #7ee787; box-shadow: 0 0 5px #7ee787; }
  .rin-tab.is-busy i { background: #f7be00; }
  .rin-tab-x { display: inline-grid; place-items: center; width: 16px; height: 16px; border-radius: 4px; color: rgb(221 224 229 / .5); font-size: 12px; line-height: 1; opacity: 0; transition: opacity var(--t-fast) var(--soft); }
  .rin-tab.is-on .rin-tab-x, .rin-tab:hover .rin-tab-x, .rin-tab:focus-within .rin-tab-x { opacity: 1; }
  .rin-tab-x:hover { background: rgb(255 255 255 / .12); color: var(--slate-fg); }
  .rin-tab-add { height: 26px; min-width: 26px; padding: 0 6px; border-radius: 7px; color: rgb(221 224 229 / .6); font: inherit; font-size: 14px; }
  .rin-tab-add:hover { background: rgb(255 255 255 / .05); color: var(--slate-fg); }
  .term { position: relative; padding: 12px 16px 8px; font-size: 13px; line-height: 1.6; overflow-y: auto; overscroll-behavior: contain; outline: none; cursor: text; }
  .term:focus-within { box-shadow: inset 0 0 0 1px rgb(126 231 135 / .3); }
  .term-out { white-space: pre-wrap; overflow-wrap: anywhere; color: rgb(221 224 229 / .92); }
  .term-out .dim { color: rgb(221 224 229 / .55); }
  .term-out .ok { color: #7ee787; }
  .term-out .amber { color: #f7be00; }
  .term-out .cmd { color: #5dd8ff; }
  .term-out a { color: #5dd8ff; text-decoration: underline; text-underline-offset: 3px; }
  .term-line { display: flex; align-items: baseline; gap: 8px; }
  .term-ps { color: #7ee787; font-weight: 600; }
  .term-in { white-space: pre; color: #5dd8ff; }
  .caret { display: inline-block; width: 7px; height: 14px; background: var(--slate-fg); transform: translateY(2px); }
  .term:focus-within .caret { animation: blink 1.05s step-end infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .term-real { pointer-events: none; }
  .rin-try { display: flex; align-items: center; gap: 6px; padding: 0 10px; box-shadow: 0 -.5px 0 rgb(255 255 255 / .08); font-size: 11px; min-width: 0; }
  .rin-try-lbl { color: rgb(221 224 229 / .45); flex: none; }
  .rin-try-list { display: flex; gap: 4px; overflow-x: auto; scrollbar-width: none; min-width: 0; flex: 1; padding: 4px 0; }
  .rin-try-list button { position: relative; flex: none; height: 22px; padding: 0 9px; border-radius: 6px; background: rgb(255 255 255 / .06); color: rgb(221 224 229 / .8); font: inherit; font-family: var(--mono); font-size: 11px; white-space: nowrap; transition: background-color var(--t-fast) var(--soft), color var(--t-fast) var(--soft), transform var(--t-fast) var(--soft); }
  .rin-try-list button::before { content: ''; position: absolute; left: 0; right: 0; top: 50%; translate: 0 -50%; height: 44px; }
  .rin-try-list button:hover { background: rgb(255 255 255 / .12); color: var(--slate-fg); }
  .rin-try-list button:active { transform: scale(.97); }
  .rin-demo { flex: none; font-size: 10px; letter-spacing: .06em; text-transform: uppercase; color: rgb(221 224 229 / .5); padding: 2px 7px; border-radius: 4px; box-shadow: inset 0 0 0 .5px rgb(221 224 229 / .25); }
  .rin :is(button):focus-visible { outline: 3px solid rgb(126 231 135 / .6); outline-offset: 2px; }
  .is-narrow .term { font-size: 12px; padding: 10px 12px 8px; }
  .is-narrow .rin-tabs { padding: 0 6px; }
</style>
