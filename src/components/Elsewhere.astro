---
const tiles = [
  { k: 'FIRST Robotics', t: 'Started the team.', s: 'Rookie All-Star at Worlds, first season out.', glyph: 'robot' },
  { k: 'Climbing', t: 'Flashes V7. Projecting V10.', s: 'Speed nationals with USA Climbing. Belay and lead certified.', glyph: 'climb' },
  { k: 'Paby LLC', t: 'Ran the warehouse.', s: 'Ordering, inventory, fulfilment. One summer, one lighting company.', glyph: 'box' },
];
---
<section class="section" id="elsewhere" data-accent="#f25c1f" data-face="(¬‿¬)">
  <div class="wrap">
    <p class="eyebrow reveal">Elsewhere</p>
    <h2 class="t-display reveal" data-split="lines">Also: the parts <span class="serif grad">without a keyboard.</span></h2>
    <ul class="tiles">
      {tiles.map((t, i) => (
        <li class="tile sq reveal" style={`--i:${i}`} data-glyph={t.glyph}>
          <div class="glyph" aria-hidden="true"><span></span><span></span><span></span></div>
          <p class="eyebrow">{t.k}</p>
          <h3 class="t-card">{t.t}</h3>
          <p class="muted tile-s">{t.s}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 40px; }
  .tile { --r: var(--r-card); position: relative; padding: 28px 26px 30px; background: rgb(255 255 255 / .55); border: .5px solid rgb(var(--espresso) / .12); box-shadow: var(--shadow-card); display: grid; gap: 10px; transition-delay: calc(var(--i) * 90ms); }
  .tile:hover { border-color: rgb(var(--espresso) / .22); }
  .tile-s { font-size: var(--t-small); line-height: 1.45; }
  .glyph { height: 64px; margin-bottom: 8px; position: relative; }
  .glyph span { position: absolute; background: var(--accent); border-radius: 6px; transition: transform var(--t-slow) var(--boing), background-color var(--t-slow) var(--settle); }
  [data-glyph="robot"] .glyph span:nth-child(1) { left: 0; top: 14px; width: 44px; height: 36px; border-radius: 10px; }
  [data-glyph="robot"] .glyph span:nth-child(2) { left: 10px; top: 26px; width: 8px; height: 8px; background: var(--paper); border-radius: 50%; }
  [data-glyph="robot"] .glyph span:nth-child(3) { left: 26px; top: 26px; width: 8px; height: 8px; background: var(--paper); border-radius: 50%; }
  .tile[data-glyph="robot"]:hover .glyph span:nth-child(1) { transform: rotate(-6deg) translateY(-3px); }
  [data-glyph="climb"] .glyph span:nth-child(1) { left: 6px; top: 46px; width: 14px; height: 14px; border-radius: 50%; }
  [data-glyph="climb"] .glyph span:nth-child(2) { left: 28px; top: 26px; width: 14px; height: 14px; border-radius: 50%; }
  [data-glyph="climb"] .glyph span:nth-child(3) { left: 50px; top: 6px; width: 14px; height: 14px; border-radius: 50%; }
  .tile[data-glyph="climb"]:hover .glyph span:nth-child(1) { transform: translateY(-40px) translateX(44px); }
  [data-glyph="box"] .glyph span:nth-child(1) { left: 0; top: 24px; width: 46px; height: 34px; border-radius: 6px; }
  [data-glyph="box"] .glyph span:nth-child(2) { left: 0; top: 14px; width: 46px; height: 12px; border-radius: 6px 6px 2px 2px; transform-origin: 0 100%; }
  [data-glyph="box"] .glyph span:nth-child(3) { left: 19px; top: 30px; width: 8px; height: 20px; background: var(--paper); border-radius: 2px; }
  .tile[data-glyph="box"]:hover .glyph span:nth-child(2) { transform: rotateX(70deg) translateY(-4px); }
  @media (max-width: 820px) { .tiles { grid-template-columns: 1fr; } }
</style>
