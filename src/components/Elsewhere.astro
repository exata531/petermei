---
/* The bento: six things that are not software, one line each. */
const tiles = [
  { t: 'FIRST Robotics', p: 'Founded the school’s team in tenth grade and still lead it. Worlds in the first season, second-ranked rookie team in Michigan.', icon: '<rect x="4" y="7.5" width="16" height="12" rx="3"/><circle cx="9.5" cy="13" r="1.2"/><circle cx="14.5" cy="13" r="1.2"/><path d="M12 7.5v-3M9 4.5h6"/>' },
  { t: 'Climbing', p: 'Bouldering and speed. Flashes V7, projecting V10. Six years at the gym, four on the team, speed nationals in 2025.', icon: '<path d="M4 19 10 7l3 5 2-3 5 10z"/><path d="M8.5 19v-4"/>' },
  { t: 'Paby LLC', p: 'Ran the warehouse for a lighting company one summer: ordering, inventory, and fulfilment, start to finish.', icon: '<path d="M4 8.5 12 4l8 4.5v8L12 21l-8-4.5z"/><path d="M4 8.5 12 13l8-4.5M12 13v8"/>' },
  { t: 'Cross country', p: 'Two varsity years. States as a freshman, then climbing took the season.', icon: '<path d="M5 18h6l2-4 3 2 3-3"/><path d="M13 6.5a1.5 1.5 0 1 0 0-.01"/><path d="M8 13l3-3 3 1 2-3"/>' },
  { t: 'Mandarin', p: 'Spoken at home, so the second language came free. Swift, TypeScript, and Python were the ones that took work.', icon: '<path d="M4.5 6.5h15v9h-8l-4 3v-3h-3z"/><path d="M8.5 10.5h7M8.5 13h4"/>' },
  { t: 'A camera', p: 'A Canon, mostly in Michigan, mostly things that hold still. A few of them are further down.', icon: '<rect x="3.5" y="7" width="17" height="12" rx="3"/><circle cx="12" cy="13" r="3.2"/><path d="M8.5 7 10 4.5h4L15.5 7"/>', href: '#photos' },
];
---
<section id="elsewhere" aria-labelledby="bento-title">
  <div class="wrap">
    <div class="head up">
      <p class="eyebrow">Elsewhere</p>
      <h2 id="bento-title">The parts without a keyboard</h2>
    </div>
    <div class="bento">
      {tiles.map((t) => (
        t.href
          ? <a class="tile up" href={t.href}><svg viewBox="0 0 24 24" aria-hidden="true" set:html={t.icon}></svg><h3>{t.t}</h3><p>{t.p}</p></a>
          : <div class="tile up"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={t.icon}></svg><h3>{t.t}</h3><p>{t.p}</p></div>
      ))}
    </div>
  </div>
</section>

<style>
  #elsewhere { padding-top: var(--sec); }
  .bento { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 40px; }
  @media (max-width: 860px) { .bento { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .bento { grid-template-columns: 1fr; } }
</style>
