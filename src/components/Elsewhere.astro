---
/* Not software. Three rows, each one fact and one line under it. */
const rows = [
  { k: 'FIRST Robotics', t: 'Founded the school’s team in tenth grade and still lead it.', s: 'Reached Worlds in the first season as Michigan’s second-ranked rookie team.' },
  { k: 'Climbing', t: 'Bouldering and speed. Flashes V7, projecting V10.', s: 'Six years at Planet Rock, four on the competitive team. USA Climbing speed nationals in 2025.' },
  { k: 'Paby LLC', t: 'Ran the warehouse for a lighting company one summer.', s: 'Ordering, inventory, and fulfilment, start to finish.' },
];
---
<section class="section" id="elsewhere" data-accent="#f25c1f" data-face="(¬‿¬)">
  <div class="wrap"><div class="col">
    <h2 class="t-head reveal">Elsewhere</h2>
    <ul class="rows">
      {rows.map((r, i) => (
        <li class="rowi reveal" style={`--i:${i}`}>
          <span class="rk mono">{r.k}</span>
          <div class="rb">
            <p class="rt">{r.t}</p>
            <p class="rs muted">{r.s}</p>
          </div>
        </li>
      ))}
    </ul>
  </div></div>
</section>

<style>
  .rows { margin-top: 28px; border-top: .5px solid rgb(var(--espresso) / .16); }
  .rowi { display: grid; grid-template-columns: 150px 1fr; gap: 20px; padding: 22px 0; border-bottom: .5px solid rgb(var(--espresso) / .16); transition-delay: calc(var(--i) * 60ms); }
  .rk { font-size: var(--t-fine); color: var(--ink-3); padding-top: 3px; }
  .rb { display: grid; gap: 4px; }
  .rt { font-size: var(--t-body); font-weight: 550; color: var(--ink); letter-spacing: -0.01em; }
  .rs { font-size: var(--t-small); line-height: 1.5; }
  @media (max-width: 600px) { .rowi { grid-template-columns: 1fr; gap: 8px; } }
</style>
