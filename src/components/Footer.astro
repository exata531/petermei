---
/* the colophon carries the real deploy: Vercel hands the build its commit,
   and a local build asks git. Never a made-up number. */
import { execSync } from 'node:child_process';
const fullSha = process.env.VERCEL_GIT_COMMIT_SHA || (() => { try { return execSync('git rev-parse HEAD', { stdio: ['ignore', 'pipe', 'ignore'] }).toString().trim(); } catch { return ''; } })();
const sha = fullSha.slice(0, 7);
const shipped = new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'America/Detroit' });
---
<footer class="foot" data-accent="#f25c1f" data-face="(´｡• ᵕ •｡`)">
  <div class="wrap foot-in">
    <div class="foot-l">
      <p class="t-card">Peter Mei</p>
      <p class="muted foot-s">Say hi on GitHub.</p>
    </div>
    <ul class="foot-links">
      <li><a href="https://github.com/exata531" target="_blank" rel="noopener">GitHub ↗</a></li>
      <li><a href="#about" data-mail-link hidden>Email ↗</a></li>
      <li><a href="https://volbase.app" target="_blank" rel="noopener">volbase ↗</a></li>
    </ul>
    <p class="colophon mono">Built with Astro and GSAP. Set in your system’s own type, Instrument Serif, and JetBrains Mono. No tracking.{sha && <><br />Last shipped {shipped} from <a class="sha" href={`https://github.com/exata531/petermei/commit/${fullSha}`} target="_blank" rel="noopener">{sha}</a>.</>}</p>
  </div>
</footer>

<style>
  .foot { border-top: .5px solid rgb(var(--espresso) / .14); padding: 48px 0 40px; }
  .foot-in { display: grid; grid-template-columns: 1fr auto; gap: 24px 48px; align-items: start; }
  .foot-s { font-size: var(--t-small); margin-top: 4px; }
  .foot-links { display: flex; gap: 22px; font-size: var(--t-ui); font-weight: 600; }
  .foot-links a { transition: color var(--t-fast) var(--settle); }
  .foot-links a:hover { color: var(--accent); }
  .colophon { grid-column: 1 / -1; font-size: 11.5px; color: var(--ink-3); max-width: 64ch; line-height: 1.7; }
  .sha { color: var(--ink-2); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: rgb(var(--espresso) / .25); }
  .sha:hover { color: var(--ink); text-decoration-color: currentColor; }
  @media (max-width: 720px) { .foot-in { grid-template-columns: 1fr; } }
</style>
