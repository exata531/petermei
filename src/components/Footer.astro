---
/* The close, then the colophon. The colophon carries the real deploy: Vercel
   hands the build its commit, and a local build asks git. Never a made-up
   number. The email and resume slots stay hidden until there is something
   real to put in them. */
import { execSync } from 'node:child_process';
const fullSha = process.env.VERCEL_GIT_COMMIT_SHA || (() => { try { return execSync('git rev-parse HEAD', { stdio: ['ignore', 'pipe', 'ignore'] }).toString().trim(); } catch { return ''; } })();
const sha = fullSha.slice(0, 7);
const shipped = new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'America/Detroit' });
---
<footer class="foot" id="contact" data-accent="#f25c1f" data-face="(´｡• ᵕ •｡`)">
  <div class="wrap">
    <div class="close">
      <p class="close-sub reveal">I like working on things that have to actually run on a Monday morning.</p>
      <h2 class="t-hero close-h reveal" data-split="lines">If you&rsquo;re building something, tell me about it.</h2>
      <div class="close-links reveal">
        <a class="lk" href="https://github.com/exata531" target="_blank" rel="noopener">GitHub<span aria-hidden="true">&#8599;</span></a>
        <a class="lk" href="https://volbase.app" target="_blank" rel="noopener">volbase.app<span aria-hidden="true">&#8599;</span></a>
        <a class="lk" href="https://github.com/exata531/Rin" target="_blank" rel="noopener">Rin source<span aria-hidden="true">&#8599;</span></a>
        <a class="lk" href="#about" data-mail-link hidden>Email<span aria-hidden="true">&#8599;</span></a>
        <a class="lk" href="/Peter-Mei-Resume.pdf" data-resume hidden>Resume<span aria-hidden="true">&#8599;</span></a>
      </div>
    </div>

    <div class="colo">
      <p class="mono">Peter Mei. Detroit, Michigan.</p>
      <p class="mono">
        Built with Astro and GSAP, set in Instrument Serif and JetBrains Mono. Nothing here tracks you.{sha && <><br />Last shipped {shipped} from <a class="sha" href={`https://github.com/exata531/petermei/commit/${fullSha}`} target="_blank" rel="noopener">{sha}</a>.</>}
      </p>
    </div>
  </div>
</footer>

<style>
  .foot { border-top: .5px solid var(--rule); padding: clamp(72px, 10vw, 140px) 0 44px; }
  .close { display: grid; gap: 18px; }
  .close-h { max-width: 15ch; color: var(--ink); }
  .close-sub { font-size: var(--t-body); color: var(--ink-2); max-width: 44ch; line-height: 1.55; }
  .close-links { display: flex; flex-wrap: wrap; gap: 10px 26px; margin-top: 12px; }
  .lk { display: inline-flex; align-items: center; gap: 6px; font-size: var(--t-ui); font-weight: 600; border-bottom: 1.5px solid var(--rule-strong); padding-bottom: 3px; }
  .lk:hover { color: var(--accent); border-bottom-color: var(--accent); }

  .colo { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px 48px; flex-wrap: wrap; margin-top: clamp(56px, 8vw, 110px); padding-top: 22px; border-top: .5px solid var(--rule); }
  .colo p { font-size: 11.5px; color: var(--ink-3); line-height: 1.75; max-width: 62ch; }
  .sha { color: var(--ink-2); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: rgb(var(--espresso) / .25); }
  .sha:hover { color: var(--ink); text-decoration-color: currentColor; }
  @media (max-width: 720px) { .close-h { max-width: none; } .colo { flex-direction: column; align-items: flex-start; } }
</style>
