---
/* The thread between rooms. Zainab Kabira threads her page with a dashed
   flight path and a paper plane; this is the same job done in Peter's own
   material, a hairline trace with right-angle bends and a node at each turn.
   It crosses the column, which is the entire point of it, and it draws itself
   as you scroll past. Decorative, so it is hidden from the reader. */
interface Props { dir?: 'lr' | 'rl' }
const { dir = 'lr' } = Astro.props;
const d = dir === 'lr'
  ? 'M 120 0 L 120 74 L 1080 74 L 1080 160'
  : 'M 1080 0 L 1080 74 L 120 74 L 120 160';
const nodes = dir === 'lr' ? [[120, 74], [1080, 74]] : [[1080, 74], [120, 74]];
---
<div class="thread" aria-hidden="true" data-thread>
  <svg viewBox="0 0 1200 160" preserveAspectRatio="none" focusable="false">
    <path d={d} pathLength="1" data-thread-path />
    {nodes.map(([x, y]) => (<rect x={x - 3} y={y - 3} width="6" height="6" data-thread-node />))}
  </svg>
</div>

<style>
  .thread { position: relative; height: clamp(90px, 13vh, 160px); pointer-events: none; }
  .thread svg { width: 100%; height: 100%; overflow: visible; }
  .thread path { fill: none; stroke: var(--accent); stroke-width: 1.25; vector-effect: non-scaling-stroke; opacity: .55; }
  .thread rect { fill: var(--accent); opacity: .55; }
  .js .thread path { stroke-dasharray: 1; stroke-dashoffset: 1; }
  .js .thread rect { opacity: 0; transition: opacity .4s var(--ease); }
  .js .thread.is-lit rect { opacity: .55; }
  @media (prefers-reduced-motion: reduce) {
    .js .thread path { stroke-dashoffset: 0; }
    .js .thread rect { opacity: .55; }
  }
</style>
