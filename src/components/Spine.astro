---
const facts = [
  { n: '4', label: 'products, all running on this page' },
  { n: '1', label: 'startup with real users' },
  { n: '2', label: 'native Apple apps, in Swift' },
  { n: '1', label: 'warehouse run, one summer' },
];
---
<section class="spine section" id="spine" data-accent="#f25c1f">
  <div class="wrap spine-in">
    <p class="t-title spine-line reveal" data-split="lines">I’m a senior at the school, outside Detroit. Nobody taught me this; I read <span class="serif grad">the docs.</span></p>
    <ul class="facts">
      {facts.map((f, i) => (
        <li class="fact reveal" style={`--i:${i}`}>
          <span class="fact-n t-display num" data-count={f.n}>{f.n}</span>
          <span class="fact-l muted">{f.label}</span>
        </li>
      ))}
    </ul>
    <div class="spine-foot reveal">
      <div class="row" style="--gap:10px">
        <button class="copy sq" type="button" data-copy="mailto" data-copy-value="" hidden>Email<span class="copy-hint mono">copy</span></button>
        <a class="copy sq" href="/Peter-Mei-Resume.pdf" data-resume hidden>Resume<span class="copy-hint mono">pdf</span></a>
        <a class="copy sq" href="https://github.com/exata531" target="_blank" rel="noopener">GitHub<span class="copy-hint mono">↗</span></a>
      </div>
      <p class="status mono"><span class="live" aria-hidden="true"></span>shipping Kyou · running volbase · applying to college this fall</p>
    </div>
  </div>
</section>

<style>
  .spine { padding-block: clamp(48px, 8vw, 120px) var(--sec); }
  .spine-in { display: grid; gap: clamp(36px, 5vw, 64px); }
  .spine-line { max-width: 22ch; }
  .facts { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; border-top: .5px solid rgb(var(--espresso) / .18); padding-top: 28px; }
  .fact { display: grid; gap: 6px; transition-delay: calc(var(--i) * 70ms); }
  .fact-n { font-size: clamp(44px, 6vw, 84px); line-height: 1; letter-spacing: -0.04em; color: var(--ink); }
  .fact-l { font-size: var(--t-small); max-width: 22ch; line-height: 1.35; }
  .spine-foot { display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
  .copy { --r: 12px; display: inline-flex; align-items: center; gap: 10px; height: 40px; padding-inline: 14px; font-size: var(--t-ui); font-weight: 600; background: rgb(var(--espresso) / .05); transition: background-color var(--t-fast) var(--settle), transform var(--t-base) var(--spring); }
  .copy:hover { background: rgb(var(--espresso) / .09); transform: translateY(-1px); }
  .copy-hint { font-size: 11px; color: var(--ink-3); font-weight: 500; }
  .status { font-size: 12.5px; color: var(--ink-2); display: inline-flex; align-items: center; gap: 9px; }
  .live { width: 8px; height: 8px; border-radius: 50%; background: var(--acc-me); box-shadow: 0 0 0 0 color-mix(in oklab, var(--acc-me) 45%, transparent); animation: live 2.4s var(--out-quart) infinite; }
  @keyframes live { 0% { box-shadow: 0 0 0 0 color-mix(in oklab, var(--acc-me) 45%, transparent); } 70% { box-shadow: 0 0 0 9px transparent; } 100% { box-shadow: 0 0 0 0 transparent; } }
  @media (max-width: 820px) { .facts { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .facts { grid-template-columns: 1fr; } }
</style>
