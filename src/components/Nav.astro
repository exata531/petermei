---
/* The nav from the Rin site, worn by its author: a black tile with the
   initial, the name, quiet links, one beige button. Goes solid on scroll. */
---
<nav class="nav" id="nav" aria-label="Main" data-nav>
  <a class="mark" href="#top"><span class="mk">P</span> Peter Mei</a>
  <div class="right">
    <a class="quiet opt" href="#work">Work</a>
    <a class="quiet opt" href="#elsewhere">Elsewhere</a>
    <a class="quiet opt" href="#photos">Photos</a>
    <a class="quiet" href="#about">About</a>
    <a class="btn btn--beige" href="https://github.com/exata531" target="_blank" rel="noopener">GitHub</a>
  </div>
</nav>

<style>
  .nav { position: fixed; inset: 0 0 auto; z-index: 60; display: flex; align-items: center; gap: 20px; padding: 13px var(--gut); }
  .nav::before {
    content: ""; position: absolute; inset: 0; z-index: -1;
    background: color-mix(in srgb, var(--cream) 82%, transparent);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--line) 70%, transparent);
    opacity: 0; transition: opacity .4s var(--settle);
  }
  .nav.solid::before { opacity: 1; }
  .mark { display: inline-flex; align-items: center; gap: var(--mark-gap); font-size: var(--mark-text); font-weight: 800; letter-spacing: -.4px; }
  .mk {
    flex: none; position: relative; width: var(--mark-tile); height: var(--mark-tile);
    border-radius: var(--r-tile); overflow: hidden; line-height: 1;
    background: var(--solid); color: var(--solid-fg); display: grid; place-items: center;
    font-size: var(--mark-glyph); font-weight: 800; box-shadow: var(--shadow-mark);
  }
  /* hover the tile and the face from the products looks back */
  .mk::after { content: "(¬‿¬)"; position: absolute; inset: 0; display: grid; place-items: center; font-family: var(--mono); font-size: 11px; font-weight: 600; background: var(--solid); opacity: 0; transition: opacity .18s var(--settle); }
  .mark:hover .mk::after { opacity: 1; }
  .right { margin-left: auto; display: flex; align-items: center; gap: 18px; }
  .quiet { font-size: var(--t-ui); font-weight: 700; color: var(--ink-2); transition: color .2s var(--settle); }
  .quiet:hover { color: var(--ink); }
  .nav .btn { padding: 11px 19px; font-size: var(--t-ui); }
  @media (max-width: 640px) { .quiet.opt { display: none; } }
</style>
