---
/* The bar: hairline cells across the top, the way sstr.tech divides its nav.
   The cell of the page you are on is filled. The right cell carries the time
   where Peter is, which is the only thing on the site that moves by itself. */
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const on = (p: string) => here === p || (p !== '/' && here.startsWith(p));
const items = [
  { href: '/', label: 'Work' },
  { href: '/about', label: 'About' },
  { href: '/playground', label: 'Playground' },
];
---
<header class="bar" transition:persist>
  <div class="bar-in">
    <a class="mark" href="/" aria-label="Peter Mei, home">
      <span class="slash" aria-hidden="true">//</span>Peter Mei
    </a>
    <nav class="links" aria-label="Main">
      {items.map((i) => (
        <a href={i.href} class:list={['nav-a', { 'is-on': i.href === '/' ? here === '/' || here.startsWith('/work') : on(i.href) }]}>
          {i.label}
        </a>
      ))}
    </nav>
    <div class="clock mono">
      <span data-wx class="wx" hidden><span data-wx-t></span></span>
      <time data-clock>Detroit</time>
    </div>
  </div>
</header>

<style>
  .bar {
    position: sticky; top: 0; z-index: 40;
    background: var(--paper); border-bottom: 1px solid var(--hair);
  }
  .bar-in {
    max-width: var(--wrap); margin-inline: auto; height: var(--nav);
    display: grid; grid-template-columns: auto 1fr auto; align-items: stretch;
    border-inline: 1px solid var(--hair);
  }
  .mark {
    display: inline-flex; align-items: center; gap: 9px;
    padding-inline: var(--pad); font-weight: 500; font-size: 15px;
    letter-spacing: -.02em; border-right: 1px solid var(--hair);
  }
  .slash { color: var(--accent); font-weight: 600; }
  .links { display: flex; }
  .nav-a {
    display: inline-flex; align-items: center; padding-inline: clamp(14px, 2vw, 26px);
    border-right: 1px solid var(--hair);
    font-family: var(--mono); font-size: var(--t-label); font-weight: 500;
    text-transform: uppercase; letter-spacing: var(--track-label); color: var(--dim);
    transition: background var(--t-fast) var(--ease), color var(--t-fast) var(--ease);
  }
  .nav-a:hover { color: var(--ink); background: var(--paper-2); }
  .nav-a.is-on { color: var(--ink); background: var(--paper-2); }
  .clock {
    display: inline-flex; align-items: center; gap: 12px;
    padding-inline: var(--pad); border-left: 1px solid var(--hair);
    font-size: var(--t-label); letter-spacing: .06em; color: var(--dim);
    text-transform: uppercase; white-space: nowrap;
  }
  .wx { display: inline-flex; align-items: center; gap: 5px; opacity: 0; }
  .wx.is-in { opacity: 1; transition: opacity var(--t-slow) var(--ease); }
  .wx::before {
    content: ''; width: 7px; height: 7px; border-radius: 50%;
    background: var(--accent); opacity: .85;
  }

  @media (max-width: 720px) {
    .bar-in { grid-template-columns: 1fr auto; height: auto; }
    .mark { grid-area: 1 / 1; height: var(--nav); border-right: 0; }
    .clock { grid-area: 1 / 2; border-left: 1px solid var(--hair); font-size: 10px; letter-spacing: .04em; }
    .links { grid-area: 2 / 1 / 3 / 3; border-top: 1px solid var(--hair); }
    .nav-a { flex: 1; justify-content: center; height: 44px; }
    .nav-a:last-child { border-right: 0; }
  }
</style>
