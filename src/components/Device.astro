---
/* One product demo, at its design pixel size, scaled down into whatever box
   it is given. The scenes were written to fill an absolutely positioned
   parent, so nothing inside them had to change. */
import Volbase from './scenes/Volbase.astro';
import Rin from './scenes/Rin.astro';
import Kyou from './scenes/Kyou.astro';
import Market from './scenes/Market.astro';

interface Props {
  scene: 'volbase' | 'rin' | 'kyou' | 'market';
  w: number; h: number; mw: number; mh: number; r: number;
  play?: 'idle' | 'auto';
  name?: string;
  cap?: string;
}
const { scene, w, h, mw, mh, r, play = 'auto', name = scene, cap } = Astro.props;
const map = { volbase: Volbase, rin: Rin, kyou: Kyou, market: Market };
const Scene = map[scene];
---
<figure class="dev" data-scene={scene} data-play={play}
        data-w={w} data-h={h} data-mw={mw} data-mh={mh}
        style={`--w:${w}px;--h:${h}px;--bw:${w}px;--bh:${h}px;--r:${r}px`}>
  <div class="dev-box">
    <div class="dev-frame" data-scene-root role="img" aria-label={`A working demo of ${name}`}>
      <Scene />
    </div>
  </div>
  {cap && <figcaption class="meta cap">{cap}</figcaption>}
</figure>

<style>
  .cap { margin-top: 14px; }
</style>
