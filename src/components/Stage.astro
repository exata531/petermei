---
/* One frame, four products. The section is tall; the pin is CSS sticky; the
   script reads scroll progress and swaps what is inside the frame. */
import Volbase from './scenes/Volbase.astro';
import Rin from './scenes/Rin.astro';
import Kyou from './scenes/Kyou.astro';
import Market from './scenes/Market.astro';
export const products = [
  { id: 'volbase', name: 'volbase', accent: '#5c79b8', face: '(☆_☆)', kicker: 'Live · volbase.app', title: 'Find it, apply once, <span class="serif grad">keep the proof.</span>', what: 'Students find volunteer programs near them, apply with one profile, and keep a record the organization signed.', hard: 'Nearest-first search on a live map, sign-in, payments, email, and end-to-end tests, built alone.', chips: ['Next.js', 'Supabase', 'Stripe', 'MapLibre', 'AI SDK'], cta: 'Open volbase', href: 'https://volbase.app', w: 960, h: 600, r: 12 },
  { id: 'rin', name: 'Rin', accent: '#f7be00', face: '(￣ヮ￣)', kicker: 'macOS · free and open source', title: 'Give your Mac <span class="serif grad">a memory.</span>', what: 'A terminal that drops down from the menu bar with an assistant that already knows your notes, your week, and your deadlines.', hard: 'Extensions get inspected, labelled, and hash-checked before they can touch anything, and the tabs survive a quit.', chips: ['Swift', 'SwiftUI', 'AppKit', 'SwiftTerm', 'Claude Code'], cta: 'Try the terminal', href: '#rin', w: 720, h: 470, r: 14 },
  { id: 'kyou', name: 'Kyou', accent: '#ff3b30', face: '(´｡• ω •｡`)', kicker: 'iOS · in progress since August', title: 'The whole day, <span class="serif grad">one scroll.</span>', what: 'Calendar, homework, and habits merged into a single timeline for today.', hard: 'A quick-add that refuses to guess. No time typed, no time invented.', chips: ['Swift 6', 'SwiftUI', 'EventKit', 'WidgetKit'], cta: 'Try quick-add', href: '#kyou', w: 300, h: 620, r: 54 },
  { id: 'market', name: 'Market Station', accent: '#0e7a70', face: '(•_•)', kicker: 'Python · running since August 19', title: 'Macro, watched <span class="serif grad">around the clock.</span>', what: 'Market signals watched all day for one reader at home, with phone alerts that don’t flap and two briefings that write themselves.', hard: 'S&P breadth computed by hand across 500 tickers, because no free API has it.', chips: ['Python', 'FastAPI', 'Chart.js', 'Cloudflare Tunnel', 'Claude'], cta: 'Flip a tile', href: '#market', w: 960, h: 600, r: 14 },
];
---
<section class="stage-sec" id="work" data-stage>
  <div class="stage-pin">
    <div class="wrap stage-grid">
      <div class="stage-copy">
        {products.map((p, i) => (
          <div class="copy-slot" data-copy-slot={p.id} data-i={i} aria-hidden={i !== 0}>
            <p class="eyebrow ck">{p.kicker}</p>
            <h2 class="t-title ct" set:html={p.title}></h2>
            <dl class="facts-3">
              <div><dt class="mono">what</dt><dd>{p.what}</dd></div>
              <div><dt class="mono">hard part</dt><dd>{p.hard}</dd></div>
              <div><dt class="mono">stack</dt><dd class="chips">{p.chips.map((c) => <span class="chip sq">{c}</span>)}</dd></div>
            </dl>
          </div>
        ))}
      </div>

      <div class="stage-frame-wrap">
        <div class="frame sq grain" data-frame style="--w:960px;--h:600px;--r:12px">
          {products.map((p, i) => (
            <div class="slot" data-slot={p.id} data-i={i} aria-hidden={i !== 0} data-accent-value={p.accent}>
              {p.id === 'volbase' && <Volbase />}
              {p.id === 'rin' && <Rin />}
              {p.id === 'kyou' && <Kyou />}
              {p.id === 'market' && <Market />}
            </div>
          ))}
          <span class="demo-pill">demo</span>
        </div>
        <div class="finish" data-finish>
          <div class="finish-row" data-finish-for="kyou" hidden>
            <span class="finish-lbl mono">finish</span>
            <button class="finish-btn is-on" type="button" data-finish-val="light">Light</button><button class="finish-btn" type="button" data-finish-val="dark">Dark</button>
          </div>
          <div class="finish-row" data-finish-for="rin" hidden>
            <span class="finish-lbl mono">mood</span>
            <button class="finish-btn mono is-on" type="button" data-face-val="(｡•ᴗ•｡)">(｡•ᴗ•｡)</button><button class="finish-btn mono" type="button" data-face-val="(￣ヮ￣)">(￣ヮ￣)</button><button class="finish-btn mono" type="button" data-face-val="(¬_¬)">(¬_¬)</button><button class="finish-btn mono" type="button" data-face-val="(>_<)">(&gt;_&lt;)</button>
          </div>
        </div>
        <ol class="pos mono" aria-label="Which product is in frame">
          {products.map((p, i) => (<li data-pos={i} class={i === 0 ? 'is-on' : ''}><span>0{i + 1}</span><em>{p.name}</em></li>))}
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  /* each product owns 140 hundredths of a screen of scroll, so a scene plays at reading pace */
  .stage-sec { position: relative; height: calc(var(--n, 4) * 140svh + 20svh); }
  .stage-pin { position: sticky; top: 0; height: 100svh; padding-top: calc(var(--bar-h) + var(--sub-h)); display: grid; align-items: center; overflow: clip; }
  .stage-grid { display: grid; grid-template-columns: minmax(280px, .72fr) minmax(0, 1.6fr); gap: clamp(24px, 4vw, 56px); align-items: start; height: min(760px, calc(100svh - var(--bar-h) - var(--sub-h) - 48px)); padding-top: 12px; }

  .stage-copy { position: relative; min-height: 360px; }
  .copy-slot { position: absolute; inset: 0; display: grid; align-content: start; gap: 18px; opacity: 0; pointer-events: none; padding-top: 6px; }
  .copy-slot.is-on { opacity: 1; pointer-events: auto; }
  .ck { color: var(--accent); transition: color var(--t-slow) var(--settle); }
  .ct { font-size: clamp(30px, 3.3vw, 48px); max-width: 13ch; }
  .facts-3 { display: grid; gap: 12px; margin: 6px 0 0; }
  .facts-3 div { display: grid; grid-template-columns: 76px 1fr; gap: 12px; align-items: baseline; border-top: .5px solid rgb(var(--espresso) / .14); padding-top: 10px; }
  .facts-3 dt { font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-3); }
  .facts-3 dd { margin: 0; font-size: var(--t-small); line-height: 1.4; color: var(--ink-2); }
  .facts-3 dd.chips { gap: 6px; }

  .stage-frame-wrap { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); justify-items: center; align-content: start; gap: 14px; min-height: 0; min-width: 0; }
  .frame {
    position: relative; width: var(--w); height: var(--h); max-width: 100%; max-height: min(720px, calc(100svh - var(--bar-h) - var(--sub-h) - 64px));
    background: var(--slate); color: var(--slate-fg);
    box-shadow: var(--shadow-device); overflow: clip; isolation: isolate;
    will-change: width, height, border-radius;
    transform: scale(var(--scale, 1)); transform-origin: 50% 0;
  }
  .slot { position: absolute; inset: 0; opacity: 0; pointer-events: none; }
  .frame.is-phone .demo-pill, .frame.is-narrow .demo-pill { display: none; }
  .slot.is-on { opacity: 1; pointer-events: auto; }
  .finish { min-height: 30px; display: grid; place-items: center; }
  .finish-row { display: inline-flex; align-items: center; gap: 4px; padding: 3px; border-radius: 999px; background: rgb(var(--espresso) / .06); }
  .finish-row[hidden] { display: none; }
  .finish-lbl { font-size: 10px; color: var(--ink-3); padding: 0 8px 0 10px; letter-spacing: .06em; text-transform: uppercase; }
  .finish-btn { height: 24px; padding: 0 11px; border-radius: 999px; font-size: 12px; font-weight: 600; color: var(--ink-2); transition: background-color var(--t-fast) var(--settle), color var(--t-fast) var(--settle); }
  .finish-btn.is-on { background: var(--paper); color: var(--ink); box-shadow: 0 1px 2px rgb(var(--espresso) / .12); }

  .pos { display: flex; gap: 16px; font-size: 11px; color: var(--ink-3); }
  .pos li { display: inline-flex; gap: 6px; align-items: baseline; transition: color var(--t-base) var(--settle); }
  .pos li em { font-style: normal; display: none; }
  .pos li.is-on { color: var(--accent); }
  .pos li.is-on em { display: inline; }

  @media (max-width: 900px) {
    .stage-sec { height: calc(var(--n, 4) * 120svh + 20svh); }
    .stage-pin { height: auto; min-height: 100svh; padding-top: calc(var(--bar-h) + var(--sub-h) + 12px); padding-bottom: 24px; align-items: start; }
    .stage-grid { grid-template-columns: 1fr; gap: 18px; align-content: start; height: auto; }
    .stage-copy { min-height: 0; }
    .copy-slot { position: static; display: none; }
    .copy-slot.is-on { display: grid; }
    .ct { font-size: clamp(28px, 7vw, 40px); }
    .facts-3 div { grid-template-columns: 64px 1fr; }
    .frame { max-height: none; }
  }
</style>
