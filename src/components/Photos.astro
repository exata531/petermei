---
/* Photography: a rail that slides sideways while the page scrolls down. The
   frames vary in width so it reads as a contact sheet, not a carousel. The
   section's height is set by the script so one pixel of scroll moves the rail
   about a pixel and a half. */
const shots = [
  { f: 'p-02', w: 4, alt: 'Cherry blossom against a grey spring sky' },
  { f: 'p-03', w: 2, alt: 'Late snow, a deer in the brush' },
  { f: 'p-05', w: 3, alt: 'An American robin on a berry branch' },
  { f: 'p-01', w: 3, alt: 'Purple hyacinth, close' },
  { f: 'p-04', w: 4, alt: 'The grille of an old orange GMC truck' },
  { f: 'p-06', w: 2, alt: 'A butterfly folded on a leaf' },
  { f: 'p-07', w: 3, alt: 'A crocus opening' },
  { f: 'p-08', w: 4, alt: 'Daffodils in a bed of periwinkle' },
  { f: 'p-09', w: 3, alt: 'A turtle sunning on a log' },
  { f: 'p-10', w: 3, alt: 'A squirrel mid-climb' },
  { f: 'p-11', w: 4, alt: 'A mallard, preening' },
  { f: 'p-12', w: 2, alt: 'Autumn canopy from below' },
];
---
<section class="photos" id="photos" data-accent="#f25c1f" data-face="(◕‿◕)" data-photos>
  <div class="photos-pin">
    <div class="wrap photos-head">
      <div class="photos-txt">
        <h2 class="t-head reveal">Photos</h2>
        <p class="photos-sub muted reveal">Shot on a Canon, mostly in Michigan, mostly things that hold still.</p>
      </div>
      <p class="photos-idx mono" aria-hidden="true"><span data-photos-idx>01</span> / {String(shots.length).padStart(2, '0')}</p>
    </div>
    <ul class="rail" data-rail>
      {shots.map((s, i) => (
        <li class={`shot sq w${s.w}`} style={`--i:${i}`} data-shot>
          <img src={`/img/photos/${s.f}.webp`} alt={s.alt} loading="lazy" decoding="async" />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .photos { position: relative; height: 320svh; overflow-x: clip; }
  .photos-pin { position: sticky; top: 0; height: 100svh; display: grid; grid-template-columns: minmax(0, 1fr); grid-template-rows: auto 1fr; align-content: start; padding-top: calc(var(--bar-h) + clamp(36px, 6vh, 64px)); padding-bottom: clamp(24px, 5vh, 56px); }
  .photos-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; }
  .photos-txt { display: grid; gap: 8px; }
  .photos-sub { font-size: var(--t-body); max-width: 40ch; }
  .photos-idx { font-size: var(--t-tiny); color: var(--ink-3); padding-bottom: 4px; }
  .rail { display: flex; gap: 16px; align-items: center; align-self: center; padding: 0 var(--gut); width: max-content; will-change: transform; }
  .shot { --r: 14px; --hh: min(52svh, 480px); flex: none; height: var(--hh); overflow: clip; background: var(--cream-2); box-shadow: var(--shadow-card); }
  .shot img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.04) translateX(var(--px, 0px)); will-change: transform; }
  .w2 { width: calc(var(--hh) * .72); }
  .w3 { width: calc(var(--hh) * 1.1); }
  .w4 { width: calc(var(--hh) * 1.5); }
  @media (max-width: 820px) {
    .photos { height: auto !important; }
    .photos-pin { position: static; height: auto; overflow: visible; }
    .rail { width: auto; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 20px; -webkit-overflow-scrolling: touch; transform: none !important; }
    .shot { scroll-snap-align: center; height: 62vw; }
    .shot img { transform: none !important; }
    .photos-idx { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .photos { height: auto !important; }
    .photos-pin { position: static; height: auto; }
    .rail { width: auto; overflow-x: auto; transform: none !important; }
  }
</style>
