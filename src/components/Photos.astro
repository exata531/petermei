---
/* Photography: a rail that slides sideways while the page scrolls down. The
   frames vary in width so it reads as a contact sheet, not a carousel. */
const shots = [
  { f: 'p-02', w: 4, alt: 'Cherry blossom against a grey spring sky' },
  { f: 'p-03', w: 2, alt: 'Late snow, a deer in the brush' },
  { f: 'p-05', w: 3, alt: 'An American robin on a berry branch' },
  { f: 'p-01', w: 3, alt: 'Purple hyacinth, close' },
  { f: 'p-04', w: 4, alt: 'The grille of an old orange GMC truck' },
  { f: 'p-06', w: 2, alt: 'A butterfly folded on a leaf' },
  { f: 'p-07', w: 3, alt: 'A crocus opening' },
  { f: 'p-08', w: 4, alt: 'Daffodils in a bed of periwinkle' },
  { f: 'p-09', w: 3, alt: 'A turtle sunning on a log' },
  { f: 'p-10', w: 3, alt: 'A squirrel mid-climb' },
  { f: 'p-11', w: 4, alt: 'A mallard, preening' },
  { f: 'p-12', w: 2, alt: 'Autumn canopy from below' },
];
---
<section class="photos" id="photos" data-dark data-accent="#e8c07a" data-face="(◕‿◕)" data-photos>
  <div class="photos-pin">
    <div class="wrap photos-head">
      <p class="eyebrow reveal">Photos</p>
      <h2 class="t-display reveal" data-split="lines">The other thing I do is take pictures.</h2>
      <p class="photos-sub reveal">Shot on a Canon, mostly around Michigan. There are no people in any of them, which started as an accident and then turned into a rule.</p>
      <p class="photos-idx mono" aria-hidden="true"><span data-photos-idx>01</span> / {String(shots.length).padStart(2, '0')}</p>
    </div>
    <ul class="rail" data-rail>
      {shots.map((s, i) => (
        <li class={`shot sq w${s.w}`} style={`--i:${i}`} data-shot data-wipe>
          <img src={`/img/photos/${s.f}.webp`} alt={s.alt} loading="lazy" decoding="async" />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* the photo wall is the one room with the lights off. Pictures need a dark
     ground more than a cream one, and it tells the eye it has moved rooms. */
  .photos { position: relative; height: 320svh; overflow-x: clip; background: var(--night); --ink: #f2ece2; --ink-2: #b6ada0; --ink-3: #8b8377; --cream-2: #211d18; }
  .photos-pin { position: sticky; top: 0; height: 100svh; display: grid; grid-template-columns: minmax(0, 1fr); grid-template-rows: auto 1fr; align-content: start; padding-top: calc(var(--bar-h) + 46px); }
  .photos-head { display: grid; gap: 12px; position: relative; }
  .photos-head h2 { max-width: 16ch; color: var(--ink); }
  .photos-sub { font-size: var(--t-body); line-height: 1.55; color: var(--ink-2); max-width: 52ch; }
  .photos-idx { position: absolute; right: 0; bottom: 4px; font-size: 12px; color: var(--ink-3); }
  .rail { display: flex; gap: 18px; align-items: center; padding: 36px var(--gut) 0; width: max-content; will-change: transform; }
  .shot { --r: 18px; flex: none; height: min(58svh, 520px); overflow: clip; background: var(--cream-2); box-shadow: var(--shadow-card); }
  .shot img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.04) translateX(var(--px, 0px)); will-change: transform; transition: transform .6s var(--ease); }
  .shot:hover img { transform: scale(1.08) translateX(var(--px, 0px)); }
  .w2 { width: calc(min(58svh, 520px) * .72); }
  .w3 { width: calc(min(58svh, 520px) * 1.1); }
  .w4 { width: calc(min(58svh, 520px) * 1.5); }
  @media (max-width: 820px) {
    .photos { height: auto !important; }
    .photos-pin { position: static; height: auto; overflow: visible; }
    .rail { width: auto; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 20px; -webkit-overflow-scrolling: touch; transform: none !important; }
    .shot { scroll-snap-align: center; height: 62vw; }
    .shot img { transform: none !important; }
    .photos-idx { position: static; margin-top: 6px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .photos { height: auto !important; }
    .photos-pin { position: static; height: auto; }
    .rail { width: auto; overflow-x: auto; transform: none !important; }
  }
</style>
