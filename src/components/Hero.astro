---
/* The opening. Words on the left, the index of the four products on the right,
   and the two columns deliberately do not start at the same height. Every fact
   here is on the record. The index is plain HTML with nothing in front of it,
   so a reader who leaves after one screen still gets the whole map. */
const index = [
  { id: 'volbase', n: '01', name: 'volbase', accent: 'var(--acc-volbase)', line: 'Students find volunteer work near them. Live, with real people on it.' },
  { id: 'rin', n: '02', name: 'Rin', accent: 'var(--acc-rin)', line: 'A terminal that drops out of the menu bar. Free, and the code is public.' },
  { id: 'kyou', n: '03', name: 'Kyou', accent: 'var(--acc-kyou)', line: 'My whole day on one screen. Still being built, on my own phone.' },
  { id: 'market', n: '04', name: 'Market Station', accent: 'var(--acc-market)', line: 'Watches the market all day and sends a phone alert when something moves.' },
];
---
<section class="hero" id="top" data-accent="#f25c1f" data-face="(｡•ᴗ•｡)">
  <div class="wrap hero-grid">
    <div class="hero-say">
      <p class="eyebrow hero-eye" data-load="eye">Detroit, Michigan</p>
      <h1 class="t-hero hero-line" data-split="lines" data-load="name">Hi, I&rsquo;m Peter Mei. I build things, and then I keep them running.</h1>
      <div class="prose hero-p" data-load="p">
        <p>
          I&rsquo;m a senior at the school, outside Detroit. I started a robotics team,
          then a company, and somewhere in there I taught myself to write code because
          there was nobody around to do it for me.
        </p>
        <p>
          Four of the things I built are further down this page. None of them are
          screenshots. You can type into them.
        </p>
      </div>
    </div>

    <div class="hero-idx" data-load="idx">
      <p class="eyebrow idx-lbl">The work</p>
      <ol class="idx">
        {index.map((p, i) => (
          <li style={`--dot:${p.accent};--i:${i}`}>
            <a href={`#${p.id}`} data-idx-link data-target={p.id}>
              <span class="idx-n mono">{p.n}</span>
              <span class="idx-dot" aria-hidden="true"></span>
              <span class="idx-name">{p.name}</span>
              <span class="idx-line">{p.line}</span>
              <span class="idx-go" aria-hidden="true">&darr;</span>
            </a>
          </li>
        ))}
      </ol>
      <p class="idx-foot mono">
        <span class="live" aria-hidden="true"></span>Building Kyou. Running volbase. Applying to college this fall.
      </p>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; min-height: 100svh; display: grid; align-items: end; padding-top: calc(var(--bar-h) + 96px); padding-bottom: clamp(56px, 8vh, 108px); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(320px, .88fr); gap: clamp(32px, 6vw, 88px); align-items: end; }

  .hero-say { display: grid; gap: 26px; }
  .hero-line { color: var(--ink); max-width: 15ch; }
  .hero-p { max-width: 44ch; }
  .js .hero-eye, .js .hero-line, .js .hero-p, .js .hero-idx { opacity: 0; }

  /* the index: the map of the page, and the only numbers on the first screen */
  .hero-idx { display: grid; gap: 14px; align-content: end; padding-bottom: 4px; }
  .idx-lbl { color: var(--ink-3); }
  .idx { border-top: .5px solid rgb(var(--espresso) / .16); }
  .idx li { border-bottom: .5px solid rgb(var(--espresso) / .16); }
  .idx a {
    display: grid; grid-template-columns: 26px 10px 1fr 16px; column-gap: 12px; row-gap: 3px;
    align-items: center; padding: 15px 4px 16px; border-radius: 8px;
  }
  .idx-n { font-size: 11px; color: var(--ink-3); }
  .idx-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--dot); box-shadow: 0 0 0 3px color-mix(in oklab, var(--dot) 18%, transparent); }
  .idx-name { font-size: var(--t-ui); font-weight: 640; letter-spacing: -0.015em; }
  .idx-line { grid-column: 3 / 4; font-size: var(--t-small); color: var(--ink-2); line-height: 1.4; }
  .idx-go { grid-column: 4; grid-row: 1 / 3; align-self: center; justify-self: end; font-size: 13px; color: var(--ink-3); transition: transform var(--t-base) var(--ease), color var(--t-base) var(--ease); }
  .idx a:hover { background: rgb(var(--espresso) / .035); }
  .idx a:hover .idx-name { color: var(--dot); }
  .idx a:hover .idx-go { transform: translateY(3px); color: var(--dot); }

  .idx-foot { display: flex; align-items: center; gap: 9px; font-size: 11.5px; color: var(--ink-3); padding-top: 2px; }
  .live { width: 7px; height: 7px; border-radius: 50%; flex: none; background: var(--acc-me); box-shadow: 0 0 0 0 color-mix(in oklab, var(--acc-me) 45%, transparent); animation: live 2.6s var(--out-quart) infinite; }
  @keyframes live { 0% { box-shadow: 0 0 0 0 color-mix(in oklab, var(--acc-me) 45%, transparent); } 70% { box-shadow: 0 0 0 8px transparent; } 100% { box-shadow: 0 0 0 0 transparent; } }

  @media (max-width: 980px) {
    .hero { align-items: center; padding-top: calc(var(--bar-h) + 72px); }
    .hero-grid { grid-template-columns: 1fr; gap: 42px; align-items: start; }
    .hero-line { max-width: 18ch; }
  }
  @media (max-width: 560px) {
    .idx a { grid-template-columns: 24px 8px 1fr; column-gap: 10px; }
    .idx-line { grid-column: 3 / 4; }
    .idx-go { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-eye, .hero-line, .hero-p, .hero-idx { opacity: 1; }
    .live { animation: none; }
  }
</style>
