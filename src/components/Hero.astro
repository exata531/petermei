---
/* The first screen carries the facts with no scroll and no script: name, one
   paragraph, the links, and what is happening now. The frame with the first
   product sits just below the fold, so the work is the second thing seen. */
---
<section class="hero" id="top" data-accent="#f25c1f" data-face="(｡•ᴗ•｡)">
  <div class="wrap"><div class="col hero-in">
    <h1 class="t-name hero-name" data-load>Peter Mei</h1>
    <p class="t-lead hero-line" data-load>
      Senior at the school, outside Detroit. I build software and ship it: a volunteering
      platform with real users, a terminal that lives in the Mac menu bar, an iPhone day
      planner, and a market monitor that has been running since August. All four are below,
      as demos you can touch.
    </p>
    <div class="hero-foot" data-load>
      <div class="row hero-links" style="--gap:8px">
        <a class="btn btn-solid sq" href="#work">See the work</a>
        <a class="btn btn-ghost sq" href="https://github.com/exata531" target="_blank" rel="noopener">GitHub</a>
        <button class="btn btn-ghost sq" type="button" data-copy="mailto" data-copy-value="" hidden>Email<span class="hint copy-hint">copy</span></button>
        <a class="btn btn-ghost sq" href="/Peter-Mei-Resume.pdf" data-resume hidden>Resume<span class="hint">pdf</span></a>
      </div>
      <p class="status mono"><span class="live" aria-hidden="true"></span>now: shipping Kyou, running volbase, applying to college</p>
    </div>
  </div></div>
</section>

<style>
  .hero { padding-top: calc(var(--bar-h) + clamp(64px, 11vh, 128px)); padding-bottom: clamp(48px, 7vh, 88px); }
  .hero-in { display: grid; gap: 24px; }
  .hero-name { color: var(--ink); }
  .hero-line { color: var(--ink-2); max-width: 36em; }
  .hero-line strong { color: var(--ink); font-weight: 500; }
  .hero-foot { display: grid; gap: 18px; margin-top: 8px; }
  .status { font-size: var(--t-fine); color: var(--ink-3); display: inline-flex; align-items: center; gap: 9px; }
  .live { width: 7px; height: 7px; border-radius: 50%; background: var(--acc-me); box-shadow: 0 0 0 0 color-mix(in oklab, var(--acc-me) 45%, transparent); animation: live 2.4s var(--out-quart) infinite; }
  @keyframes live { 0% { box-shadow: 0 0 0 0 color-mix(in oklab, var(--acc-me) 45%, transparent); } 70% { box-shadow: 0 0 0 8px transparent; } 100% { box-shadow: 0 0 0 0 transparent; } }
  [data-load] { opacity: 0; transform: translateY(6px); }
  @media (prefers-reduced-motion: reduce) { .live { animation: none; } }
</style>
