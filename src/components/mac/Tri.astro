---
/* The outline triangle, HIG p. 218: the control beside a folder that has
   contents in a list view. Hollow, a one pixel black edge, the interior a
   fifty percent pattern, and it turns to point down when the folder's
   contents are listed. Measured off Figure 7-18: six by eleven closed,
   eleven by six open, drawn here at two units per pixel. */
---
<span class="tri" aria-hidden="true">
  <svg class="tri-shut" viewBox="0 0 6 11" width="6" height="11" shape-rendering="crispEdges" set:html={`<rect x="0" y="0" width="1" height="1" fill="#000000"/><rect x="0" y="1" width="2" height="1" fill="#000000"/><rect x="0" y="2" width="1" height="1" fill="#000000"/><rect x="2" y="2" width="1" height="1" fill="#000000"/><rect x="0" y="3" width="1" height="1" fill="#000000"/><rect x="1" y="3" width="1" height="1" fill="#9999cc"/><rect x="3" y="3" width="1" height="1" fill="#000000"/><rect x="0" y="4" width="1" height="1" fill="#000000"/><rect x="2" y="4" width="1" height="1" fill="#9999cc"/><rect x="4" y="4" width="1" height="1" fill="#000000"/><rect x="0" y="5" width="1" height="1" fill="#000000"/><rect x="1" y="5" width="1" height="1" fill="#9999cc"/><rect x="3" y="5" width="1" height="1" fill="#9999cc"/><rect x="5" y="5" width="1" height="1" fill="#000000"/><rect x="0" y="6" width="1" height="1" fill="#000000"/><rect x="2" y="6" width="1" height="1" fill="#9999cc"/><rect x="4" y="6" width="1" height="1" fill="#000000"/><rect x="0" y="7" width="1" height="1" fill="#000000"/><rect x="1" y="7" width="1" height="1" fill="#9999cc"/><rect x="3" y="7" width="1" height="1" fill="#000000"/><rect x="0" y="8" width="1" height="1" fill="#000000"/><rect x="2" y="8" width="1" height="1" fill="#000000"/><rect x="0" y="9" width="2" height="1" fill="#000000"/><rect x="0" y="10" width="1" height="1" fill="#000000"/>`} />
  <svg class="tri-open" viewBox="0 0 11 6" width="11" height="6" shape-rendering="crispEdges" set:html={`<rect x="0" y="0" width="11" height="1" fill="#000000"/><rect x="1" y="1" width="1" height="1" fill="#000000"/><rect x="3" y="1" width="1" height="1" fill="#9999cc"/><rect x="5" y="1" width="1" height="1" fill="#9999cc"/><rect x="7" y="1" width="1" height="1" fill="#9999cc"/><rect x="9" y="1" width="1" height="1" fill="#000000"/><rect x="2" y="2" width="1" height="1" fill="#000000"/><rect x="4" y="2" width="1" height="1" fill="#9999cc"/><rect x="6" y="2" width="1" height="1" fill="#9999cc"/><rect x="8" y="2" width="1" height="1" fill="#000000"/><rect x="3" y="3" width="1" height="1" fill="#000000"/><rect x="5" y="3" width="1" height="1" fill="#9999cc"/><rect x="7" y="3" width="1" height="1" fill="#000000"/><rect x="4" y="4" width="1" height="1" fill="#000000"/><rect x="6" y="4" width="1" height="1" fill="#000000"/><rect x="5" y="5" width="1" height="1" fill="#000000"/>`} />
</span>
