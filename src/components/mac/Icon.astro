---
/* One app icon, drawn.

   Every tile is the same squircle, drawn at 84% of its box the way Apple's
   icon grid leaves room around the rounded rectangle. Each one is a near-flat
   fill (never more than a few percent darker at the bottom), lit once from
   above: a one-pixel white line along the top edge and a hairline of shade
   along the bottom, the same light on every tile. The mark on each product
   tile is the product's own: volbase's lowercase v, Kyou's face, Market
   Station's one sparkline on its own dark surface, Rin's character.

   Finder, Photos, TextEdit and Trash keep the shape of their real
   counterparts so a Mac user reads them without a label, and a document is
   a page with a folded corner, never a tile. */
import { uid } from './uid';
interface Props { id: string; class?: string }
const { id, class: cls } = Astro.props;
const u = uid();
const g = `g-${u}`;
const clip = `c-${u}`;
/* the squircle, a continuous-curvature rounded square, inset to 8..92 */
const sq = 'M50 8C15.1 8 8 15.1 8 50s7.1 42 42 42 42-7.1 42-42S84.9 8 50 8Z';

/* top and bottom of each tile, within six percent of lightness of each other */
const fills: Record<string, [string, string]> = {
  volbase:  ['#fcf9f7', '#f1ede8'],
  rin:      ['#3d4352', '#30343f'],
  kyou:     ['#fdfaf5', '#f2ede5'],
  market:   ['#24262b', '#1a1b1f'],
  finder:   ['#d7effa', '#c3e6f5'],
  photos:   ['#ffffff', '#f4f0ea'],
  textedit: ['#f7f4f0', '#ece7e1'],
  github:   ['#2f343c', '#24282e'],
  folder:   ['#8fd0f2', '#7cc4ec'],
  peter:    ['#d1eef9', '#bfe4f4'],
  settings: ['#e8e4df', '#dad4cd'],
  safari:   ['#d7effa', '#c3e6f5'],
};
const [c0, c1] = fills[id] ?? fills.folder;
const squircle = id !== 'trash' && id !== 'folder' && id !== 'doc';
---
<svg class:list={['ico', cls]} viewBox="0 0 100 100" role="img" aria-hidden="true">
  <defs>
    <linearGradient id={g} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color={c0}/><stop offset="1" stop-color={c1}/>
    </linearGradient>
    <clipPath id={clip}><path d={sq}/></clipPath>
  </defs>

  {squircle && <path d={sq} fill={`url(#${g})`} />}

  {id === 'volbase' && (
    <path d="M31 33 50 70 69 33" fill="none" stroke="#4b68c3" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"/>
  )}

  {id === 'rin' && (
    <text x="50" y="51" text-anchor="middle" dominant-baseline="central"
          fill="#f2eeea" font-size="50" font-weight="500"
          font-family="'Hiragino Sans','Hiragino Kaku Gothic ProN','Noto Sans JP',system-ui,sans-serif">凛</text>
  )}

  {id === 'kyou' && (
    <g fill="none" stroke="#1c1917" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M29 34c-8 9-8 23 0 32"/>
      <path d="M71 34c8 9 8 23 0 32"/>
      <path d="M36 43l8 3-8 3M36 53h8"/>
      <path d="M64 43l-8 3 8 3M56 53h8"/>
      <path d="M44 56c0 7 12 7 12 0"/>
    </g>
  )}

  {id === 'market' && (
    <path d="M22 66 34 52l10 7 12-17 10 6 12-20" fill="none" stroke="#3f8850" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
  )}

  {id === 'finder' && (
    <g clip-path={`url(#${clip})`}>
      <path d="M8 8h44v84H8z" fill="#e8f5fc"/>
      <path d="M52 8h40v84H52z" fill="#7cbfe9"/>
      <path d="M52 8v84" stroke="#1f3b52" stroke-opacity=".35" stroke-width="1.5"/>
      <g stroke="#1f3b52" stroke-width="4.5" stroke-linecap="round" fill="none">
        <path d="M33 38v10"/><path d="M67 38v10"/>
        <path d="M32 66c6 6 30 6 36 0"/>
      </g>
      <path d="M46 58c2 5 6 7 10 6" stroke="#1f3b52" stroke-width="3.5" stroke-linecap="round" fill="none"/>
    </g>
  )}

  {id === 'photos' && (
    <g style="mix-blend-mode:multiply">
      {[0, 45, 90, 135, 180, 225, 270, 315].map((a, i) => (
        <ellipse cx="50" cy="35" rx="8" ry="15" transform={`rotate(${a} 50 50)`}
                 fill={['#f4a3a0','#f6c58b','#f3e08c','#b9de9a','#93d6d0','#8fbbee','#b3a6e8','#e9a3d2'][i]} opacity=".85"/>
      ))}
    </g>
  )}

  {id === 'textedit' && (
    <g>
      <rect x="27" y="20" width="46" height="60" rx="3" fill="#fff" stroke="#b6afa6" stroke-width="2.5"/>
      <g stroke="#b6afa6" stroke-width="3" stroke-linecap="round">
        <path d="M35 33h30"/><path d="M35 42h30"/><path d="M35 51h30"/><path d="M35 60h20"/>
      </g>
      <path d="M60 78l18-18 6 6-18 18-8 2z" fill="#f6cb98" stroke="#b25620" stroke-width="2" stroke-linejoin="round"/>
      <path d="M74 64l4 4" stroke="#b25620" stroke-width="2"/>
    </g>
  )}

  {id === 'doc' && (
    <g>
      <path d="M24 8h36l18 18v62a4 4 0 0 1-4 4H24a4 4 0 0 1-4-4V12a4 4 0 0 1 4-4Z" fill="#fff" stroke="#b6afa6" stroke-width="1"/>
      <path d="M60 8v14a4 4 0 0 0 4 4h14" fill="#ece7e1" stroke="#b6afa6" stroke-width="1"/>
      <g stroke="#b6afa6" stroke-width="3" stroke-linecap="round">
        <path d="M31 44h38"/><path d="M31 54h38"/><path d="M31 64h24"/>
      </g>
    </g>
  )}

  {id === 'github' && (
    <path fill="#fff" d="M50 22c-15.5 0-28 12.5-28 28 0 12.4 8 22.9 19.1 26.6 1.4.3 1.9-.6 1.9-1.3v-5c-7.8 1.7-9.4-3.7-9.4-3.7-1.3-3.2-3.1-4.1-3.1-4.1-2.5-1.7.2-1.7.2-1.7 2.8.2 4.3 2.9 4.3 2.9 2.5 4.3 6.5 3 8.1 2.3.3-1.8 1-3 1.8-3.7-6.2-.7-12.7-3.1-12.7-13.8 0-3.1 1.1-5.6 2.9-7.5-.3-.7-1.3-3.6.3-7.4 0 0 2.3-.8 7.7 2.9 2.2-.6 4.6-.9 7-.9s4.8.3 7 .9c5.4-3.6 7.7-2.9 7.7-2.9 1.5 3.9.6 6.7.3 7.4 1.8 2 2.9 4.5 2.9 7.5 0 10.8-6.6 13.1-12.8 13.8 1 .9 1.9 2.6 1.9 5.2v7.8c0 .7.5 1.6 1.9 1.3C70 72.9 78 62.4 78 50c0-15.5-12.5-28-28-28Z"/>
  )}

  {id === 'trash' && (
    <g>
      <path d="M26 30h48l-5 50H31z" fill="#e6ebef"/>
      <g stroke="#9aa6b0" stroke-width="3" stroke-linecap="round">
        <path d="M38 36l2 38M50 36v38M62 36l-2 38"/>
      </g>
      <path d="M26 30h48l-5 50H31z" fill="none" stroke="#7d8a95" stroke-width="2.5" stroke-linejoin="round"/>
      <rect x="22" y="24" width="56" height="8" rx="3" fill="#d4dbe0" stroke="#7d8a95" stroke-width="2.5"/>
      <path d="M42 24v-4a3 3 0 0 1 3-3h10a3 3 0 0 1 3 3v4" fill="none" stroke="#7d8a95" stroke-width="2.5"/>
    </g>
  )}

  {id === 'folder' && (
    <g>
      <path d="M10 30a6 6 0 0 1 6-6h22l8 8h38a6 6 0 0 1 6 6v40a6 6 0 0 1-6 6H16a6 6 0 0 1-6-6Z" fill="#4a9fd8"/>
      <path d="M10 40a6 6 0 0 1 6-6h68a6 6 0 0 1 6 6v38a6 6 0 0 1-6 6H16a6 6 0 0 1-6-6Z" fill={`url(#${g})`}/>
      <path d="M10 40a6 6 0 0 1 6-6h68a6 6 0 0 1 6 6v38a6 6 0 0 1-6 6H16a6 6 0 0 1-6-6Z" fill="none" stroke="#fff" stroke-opacity=".5" stroke-width="1"/>
    </g>
  )}

  {id === 'peter' && (
    <text x="50" y="52" text-anchor="middle" dominant-baseline="central"
          fill="#1f3b52" font-size="50" font-weight="600" letter-spacing="-2"
          font-family="-apple-system,'SF Pro Display',system-ui,sans-serif">P</text>
  )}

  {id === 'safari' && (
    <g>
      <circle cx="50" cy="50" r="30" fill="#fff" stroke="#7cbfe9" stroke-width="3"/>
      <g stroke="#1f3b52" stroke-opacity=".45" stroke-width="1.6" stroke-linecap="round">
        {[0, 30, 60, 90, 120, 150, 180, 210, 240, 270, 300, 330].map((a) => (
          <path d="M50 22v5" transform={`rotate(${a} 50 50)`} />
        ))}
      </g>
      <path d="M50 26 57 46 50 50 43 46Z" fill="#bb433a"/>
      <path d="M50 74 43 54 50 50 57 54Z" fill="#f2eeea" stroke="#1f3b52" stroke-opacity=".35" stroke-width="1"/>
      <circle cx="50" cy="50" r="2" fill="#1f3b52"/>
    </g>
  )}

  {id === 'settings' && (
    <g fill="none" stroke="#5b5650" stroke-width="5" stroke-linecap="round">
      <circle cx="50" cy="50" r="11"/>
      <path d="M50 24v8M50 68v8M24 50h8M68 50h8M31.6 31.6l5.7 5.7M62.7 62.7l5.7 5.7M68.4 31.6l-5.7 5.7M37.3 62.7l-5.7 5.7"/>
    </g>
  )}

  {/* one light for every tile: a line of white along the top, a hairline of shade along the bottom */}
  {squircle && <g clip-path={`url(#${clip})`}><rect x="8" y="8" width="84" height="1.2" fill="#fff" fill-opacity=".35"/><rect x="8" y="90.8" width="84" height="1.2" fill="#030302" fill-opacity=".06"/></g>}
</svg>

<style>
  .ico { width: 100%; height: 100%; display: block; }
</style>
