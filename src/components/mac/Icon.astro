---
/* One app icon, drawn.

   Every tile is the same squircle, drawn at 84% of its box the way Apple's
   icon grid leaves room around the rounded rectangle. Each one is a soft
   vertical gradient, a one-pixel inner highlight, and a crisp glyph, in
   Craft's pastels with one of Craft's muted accents for the mark. No gloss,
   no outline: a Big Sur icon is a flat fill with a long soft shadow, and the
   shadow is the tile's job, not the icon's.

   Finder, Photos, TextEdit and Trash keep the shape of their real
   counterparts so a Mac user reads them without a label. */
import { uid } from './uid';
interface Props { id: string; class?: string }
const { id, class: cls } = Astro.props;
const u = uid();
const g = `g-${u}`;
const hi = `h-${u}`;
const clip = `c-${u}`;
/* the squircle, a continuous-curvature rounded square, inset to 8..92 */
const sq = 'M50 8C15.1 8 8 15.1 8 50s7.1 42 42 42 42-7.1 42-42S84.9 8 50 8Z';

const fills: Record<string, [string, string]> = {
  volbase:  ['#dde5fb', '#b1c3f2'],
  rin:      ['#4a5162', '#22262f'],
  kyou:     ['#fdfaf5', '#ebe5db'],
  market:   ['#d6f0dc', '#a3dab0'],
  finder:   ['#d7effa', '#a9dcf3'],
  photos:   ['#ffffff', '#f1ece6'],
  textedit: ['#f7f4f0', '#e4ded7'],
  github:   ['#3a3f47', '#1b1f24'],
  folder:   ['#8fd0f2', '#5eb2e6'],
  peter:    ['#d1eef9', '#a4d6ee'],
  settings: ['#e8e4df', '#c9c3bc'],
};
const [c0, c1] = fills[id] ?? fills.folder;
const squircle = id !== 'trash' && id !== 'folder';
---
<svg class:list={['ico', cls]} viewBox="0 0 100 100" role="img" aria-hidden="true">
  <defs>
    <linearGradient id={g} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color={c0}/><stop offset="1" stop-color={c1}/>
    </linearGradient>
    <linearGradient id={hi} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity=".22"/>
      <stop offset=".4" stop-color="#fff" stop-opacity="0"/>
    </linearGradient>
    <clipPath id={clip}><path d={sq}/></clipPath>
  </defs>

  {squircle && <path d={sq} fill={`url(#${g})`} />}

  {id === 'volbase' && (
    <g fill="none" stroke="#4b68c3" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M50 74c-11-12-19-21-19-31a19 19 0 0 1 38 0c0 10-8 19-19 31Z"/>
      <circle cx="50" cy="43" r="6.5" fill="#4b68c3" stroke="none"/>
    </g>
  )}

  {id === 'rin' && (
    <text x="50" y="51" text-anchor="middle" dominant-baseline="central"
          fill="#f2eeea" font-size="50" font-weight="500"
          font-family="'Hiragino Sans','Hiragino Kaku Gothic ProN','Noto Sans JP',system-ui,sans-serif">凛</text>
  )}

  {id === 'kyou' && (
    <g fill="none" stroke="#1c1917" stroke-width="4.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M24 60c-5 6-5 18 0 24"/>
      <path d="M76 60c5 6 5 18 0 24"/>
      <path d="M33 66h8"/><path d="M59 66h8"/>
      <path d="M44 70h10l-2 8h-6"/>
    </g>
  )}

  {id === 'market' && (
    <g fill="none" stroke="#3f8850" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M24 66l15-16 12 9 25-27"/>
      <path d="M64 32h12v12"/>
    </g>
  )}

  {id === 'finder' && (
    <g clip-path={`url(#${clip})`}>
      <path d="M8 8h44v84H8z" fill="#e8f5fc"/>
      <path d="M52 8h40v84H52z" fill="#7cbfe9"/>
      <path d="M52 8v84" stroke="#1f3b52" stroke-opacity=".35" stroke-width="1.5"/>
      <g stroke="#1f3b52" stroke-width="4.5" stroke-linecap="round" fill="none">
        <path d="M33 38v10"/><path d="M67 38v10"/>
        <path d="M32 66c6 6 30 6 36 0"/>
      </g>
      <path d="M46 58c2 5 6 7 10 6" stroke="#1f3b52" stroke-width="3.5" stroke-linecap="round" fill="none"/>
    </g>
  )}

  {id === 'photos' && (
    <g style="mix-blend-mode:multiply">
      {[0, 45, 90, 135, 180, 225, 270, 315].map((a, i) => (
        <ellipse cx="50" cy="35" rx="8" ry="15" transform={`rotate(${a} 50 50)`}
                 fill={['#f4a3a0','#f6c58b','#f3e08c','#b9de9a','#93d6d0','#8fbbee','#b3a6e8','#e9a3d2'][i]} opacity=".85"/>
      ))}
    </g>
  )}

  {id === 'textedit' && (
    <g>
      <rect x="27" y="20" width="46" height="60" rx="3" fill="#fff" stroke="#c9c3bc" stroke-width="1.5"/>
      <g stroke="#b6afa6" stroke-width="2.6" stroke-linecap="round">
        <path d="M35 33h30"/><path d="M35 41h30"/><path d="M35 49h30"/><path d="M35 57h20"/>
      </g>
      <path d="M60 78l18-18 6 6-18 18-8 2z" fill="#f6cb98" stroke="#b25620" stroke-width="1.6" stroke-linejoin="round"/>
      <path d="M74 64l4 4" stroke="#b25620" stroke-width="1.6"/>
    </g>
  )}

  {id === 'github' && (
    <path fill="#fff" d="M50 22c-15.5 0-28 12.5-28 28 0 12.4 8 22.9 19.1 26.6 1.4.3 1.9-.6 1.9-1.3v-5c-7.8 1.7-9.4-3.7-9.4-3.7-1.3-3.2-3.1-4.1-3.1-4.1-2.5-1.7.2-1.7.2-1.7 2.8.2 4.3 2.9 4.3 2.9 2.5 4.3 6.5 3 8.1 2.3.3-1.8 1-3 1.8-3.7-6.2-.7-12.7-3.1-12.7-13.8 0-3.1 1.1-5.6 2.9-7.5-.3-.7-1.3-3.6.3-7.4 0 0 2.3-.8 7.7 2.9 2.2-.6 4.6-.9 7-.9s4.8.3 7 .9c5.4-3.6 7.7-2.9 7.7-2.9 1.5 3.9.6 6.7.3 7.4 1.8 2 2.9 4.5 2.9 7.5 0 10.8-6.6 13.1-12.8 13.8 1 .9 1.9 2.6 1.9 5.2v7.8c0 .7.5 1.6 1.9 1.3C70 72.9 78 62.4 78 50c0-15.5-12.5-28-28-28Z"/>
  )}

  {id === 'trash' && (
    <g>
      <path d="M26 30h48l-5 50H31z" fill="#e6ebef"/>
      <g stroke="#9aa6b0" stroke-width="1.4">
        <path d="M34 34l3 42M40 34l2 42M46 34l1 42M52 34v42M58 34l-1 42M64 34l-2 42"/>
      </g>
      <path d="M26 30h48l-5 50H31z" fill="none" stroke="#7d8a95" stroke-width="2" stroke-linejoin="round"/>
      <rect x="22" y="24" width="56" height="8" rx="3" fill="#d4dbe0" stroke="#7d8a95" stroke-width="2"/>
      <path d="M42 24v-4a3 3 0 0 1 3-3h10a3 3 0 0 1 3 3v4" fill="none" stroke="#7d8a95" stroke-width="2"/>
    </g>
  )}

  {id === 'folder' && (
    <g>
      <path d="M10 30a6 6 0 0 1 6-6h22l8 8h38a6 6 0 0 1 6 6v40a6 6 0 0 1-6 6H16a6 6 0 0 1-6-6Z" fill="#4a9fd8"/>
      <path d="M10 40a6 6 0 0 1 6-6h68a6 6 0 0 1 6 6v38a6 6 0 0 1-6 6H16a6 6 0 0 1-6-6Z" fill={`url(#${g})`}/>
      <path d="M10 40a6 6 0 0 1 6-6h68a6 6 0 0 1 6 6v38a6 6 0 0 1-6 6H16a6 6 0 0 1-6-6Z" fill="none" stroke="#fff" stroke-opacity=".5" stroke-width="1"/>
    </g>
  )}

  {id === 'peter' && (
    <text x="50" y="52" text-anchor="middle" dominant-baseline="central"
          fill="#1f3b52" font-size="50" font-weight="600" letter-spacing="-2"
          font-family="-apple-system,'SF Pro Display',system-ui,sans-serif">P</text>
  )}

  {id === 'settings' && (
    <g fill="none" stroke="#5b5650" stroke-width="5" stroke-linecap="round">
      <circle cx="50" cy="50" r="11"/>
      <path d="M50 24v8M50 68v8M24 50h8M68 50h8M31.6 31.6l5.7 5.7M62.7 62.7l5.7 5.7M68.4 31.6l-5.7 5.7M37.3 62.7l-5.7 5.7"/>
    </g>
  )}

  {squircle && <path d={sq} fill={`url(#${hi})`} />}
  {squircle && <path d={sq} fill="none" stroke="#fff" stroke-opacity=".38" stroke-width="2" clip-path={`url(#${clip})`} />}
</svg>

<style>
  .ico { width: 100%; height: 100%; display: block; }
</style>
