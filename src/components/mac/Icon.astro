---
/* One icon, drawn from its pixel grid in data/pixels.ts.

   A 32 by 32 grid rendered as crisp SVG rects, so it is the same drawing at
   every size and doubles cleanly on the pixel-doubled desktop. Nothing here
   depends on a gradient or an id, so the same icon can appear in the
   desktop, a window, a menu and the phone at once with nothing to collide. */
import { pixSvg } from '../../data/pixels';
interface Props { id: string; class?: string }
const { id, class: cls } = Astro.props;
---
<svg class:list={['ico', `ico-${id}`, cls]} viewBox="0 0 32 32" shape-rendering="crispEdges" role="img" aria-hidden="true" set:html={pixSvg(id)} />
