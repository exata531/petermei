---
/* The menu bar.

   Real proportions: 24px tall, the active app's name in bold beside its
   menus, status items on the right in the order a Mac keeps them: the Rin
   glyph while it runs, the appearance toggle, battery, Wi-Fi, search,
   Control Center, then the clock. The face where the Apple menu goes is the
   same one the Rin app wears in Peter's own menu bar, which is why it is a
   text face and not a logo.

   Nothing in here is inside a transformed ancestor, on purpose: a fixed
   element trapped inside one stops being fixed. */
---
<header class="mbar" data-mbar>
  <div class="mbar-l">
    <button class="mb-item mb-face" type="button" data-menu="apple" aria-haspopup="true" aria-expanded="false" aria-label="Main menu">
      <span data-face>(｡•ᴗ•｡)</span>
    </button>
    <button class="mb-item mb-app" type="button" data-menu="app-0" aria-haspopup="true" aria-expanded="false" data-app-name>Finder</button>
    <span class="mb-menus" data-app-menus></span>
  </div>

  <div class="mbar-r">
    <button class="mb-item mb-rin" type="button" data-rin-status hidden aria-label="Rin">凛</button>
    <button class="mb-item mb-theme" type="button" data-theme-toggle aria-label="Switch appearance" title="Switch appearance">
      <svg class="th-sun" viewBox="0 0 20 20" aria-hidden="true">
        <circle cx="10" cy="10" r="3.6"/>
        <g class="th-rays"><path d="M10 1.8v2.4M10 15.8v2.4M1.8 10h2.4M15.8 10h2.4M4.2 4.2l1.7 1.7M14.1 14.1l1.7 1.7M15.8 4.2l-1.7 1.7M5.9 14.1l-1.7 1.7"/></g>
      </svg>
      <svg class="th-moon" viewBox="0 0 20 20" aria-hidden="true">
        <path d="M15.6 12.6A6.6 6.6 0 0 1 7.4 4.4a6.6 6.6 0 1 0 8.2 8.2Z"/>
      </svg>
    </button>
    <span class="mb-item mb-bat" aria-label="Battery, full" role="img">
      <svg viewBox="0 0 30 14" aria-hidden="true"><rect x="1" y="2.2" width="24" height="9.6" rx="3"/><path d="M27 5.4v3.2"/><rect class="bat-fill" x="3" y="4.2" width="20" height="5.6" rx="1.6"/></svg>
    </span>
    <span class="mb-item mb-wifi" aria-label="Wi-Fi" role="img">
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M2.2 7.4a11 11 0 0 1 15.6 0" /><path d="M5.2 10.6a6.8 6.8 0 0 1 9.6 0" /><path d="M8.1 13.8a2.7 2.7 0 0 1 3.8 0" /><circle cx="10" cy="16.4" r="1.3" fill="currentColor" stroke="none"/></svg>
    </span>
    <button class="mb-item mb-spot" type="button" data-spot-open aria-label="Spotlight" title="Spotlight (⌘K)">
      <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.6" cy="8.6" r="5.4"/><path d="M12.6 12.6L17.4 17.4"/></svg>
    </button>
    <button class="mb-item mb-cc" type="button" data-menu="control" aria-haspopup="true" aria-expanded="false" aria-label="Control Center">
      <svg viewBox="0 0 20 20" aria-hidden="true"><rect x="1.5" y="3.5" width="17" height="5.4" rx="2.7"/><circle cx="5" cy="6.2" r="1.7" fill="currentColor" stroke="none"/><rect x="1.5" y="11.1" width="17" height="5.4" rx="2.7"/><circle cx="15" cy="13.8" r="1.7" fill="currentColor" stroke="none"/></svg>
    </button>
    <button class="mb-item mb-clock" type="button" data-menu="clock" aria-haspopup="true" aria-expanded="false"><time data-clock>Sat Aug 29  9:41 AM</time></button>
  </div>
</header>

<div class="menu" data-menu-pop hidden role="menu"></div>
