---
/* The menu bar.

   Real proportions: a strip the height of a Mac's, the active app's name in
   bold to the left of its menus, status items on the right in the order a Mac
   puts them. The face where the Apple menu goes is the same one the Rin app
   wears in Peter's own menu bar, which is why it is a text face and not a logo.

   Nothing in here is inside a transformed ancestor, on purpose: a fixed
   element trapped inside one stops being fixed. */
---
<header class="mbar" data-mbar>
  <div class="mbar-l">
    <button class="mb-item mb-face mono" type="button" data-menu="apple" aria-haspopup="true" aria-expanded="false">
      <span data-face>(｡•ᴗ•｡)</span>
    </button>
    <button class="mb-item mb-app" type="button" data-menu="app-0" aria-haspopup="true" aria-expanded="false" data-app-name>Finder</button>
    <span class="mb-menus" data-app-menus></span>
  </div>

  <div class="mbar-r">
    <span class="mb-item mb-wx" data-wx hidden>
      <span class="wx-mark" aria-hidden="true"></span><span data-wx-t></span>
    </span>
    <button class="mb-item mb-theme" type="button" data-theme-toggle aria-label="Switch appearance">
      <svg class="th-sun" viewBox="0 0 20 20" aria-hidden="true">
        <circle cx="10" cy="10" r="4"/>
        <g class="th-rays"><path d="M10 1.5v2.2M10 16.3v2.2M1.5 10h2.2M16.3 10h2.2M4 4l1.6 1.6M14.4 14.4L16 16M16 4l-1.6 1.6M5.6 14.4L4 16"/></g>
      </svg>
      <svg class="th-moon" viewBox="0 0 20 20" aria-hidden="true">
        <path d="M15.6 12.6A6.6 6.6 0 0 1 7.4 4.4a6.6 6.6 0 1 0 8.2 8.2Z"/>
      </svg>
    </button>
    <button class="mb-item mb-spot" type="button" data-spot-open aria-label="Search">
      <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.8" cy="8.8" r="5.2"/><path d="M12.7 12.7L17 17"/></svg>
    </button>
    <span class="mb-item mb-bat" aria-hidden="true">
      <svg viewBox="0 0 30 14"><rect x="1" y="2.4" width="24" height="9.2" rx="3"/><path d="M27 5.6v2.8"/><rect class="bat-fill" x="3" y="4.4" width="14" height="5.2" rx="1.4"/></svg>
    </span>
    <time class="mb-item mb-clock" data-clock>Detroit</time>
  </div>
</header>

<div class="menu" data-menu-pop hidden role="menu"></div>
