---
/* Everything that can end up inside a window, rendered once, up front.

   Windows do not clone these; they move them. A demo therefore mounts a single
   time and keeps whatever you typed into it when you close its window and open
   it again. With JavaScript off nothing moves anywhere and this file is the
   whole site: real headings, real links, no desktop. */
import Volbase from '../scenes/Volbase.astro';
import Rin from '../scenes/Rin.astro';
import Kyou from '../scenes/Kyou.astro';
import Market from '../scenes/Market.astro';
import Icon from './Icon.astro';
import Photos from './Photos.astro';
import Pictures from './Pictures.astro';
import { apps, finder, readme, links, aboutPeter } from '../../data/apps';
import { photos } from '../../data/photos';

/* what the scripts need to know about a photo, once, as JSON */
const photoJson = JSON.stringify(photos.map((p) => ({ f: p.file, n: p.name, w: p.w, h: p.h, a: p.alt, p: p.place, d: p.dayLabel, m: p.month, ml: p.monthLabel })));
const scenes = { volbase: Volbase, rin: Rin, kyou: Kyou, market: Market };
const glyphs: Record<string, string> = {
  person: '<circle cx="8" cy="5.2" r="2.8"/><path d="M2.8 13.6c.6-2.8 2.6-4.2 5.2-4.2s4.6 1.4 5.2 4.2"/>',
  pictures: '<path d="M2.5 4.5h11a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1h-11a1 1 0 0 1-1-1v-6a1 1 0 0 1 1-1Z"/><path d="M2.5 11 6 7.5l2.5 2.5 2-1.5 3.5 2.5"/><circle cx="10.5" cy="7" r="1" fill="currentColor" stroke="none"/>',
  hammer: '<path d="M9.5 3.5 12.5 6.5 5 14l-3-3Z"/><path d="M8 5 11 2l3 3-3 3"/>',
  star: '<path d="M8 1.8l1.9 4 4.4.6-3.2 3 .8 4.4L8 11.7l-3.9 2.1.8-4.4-3.2-3 4.4-.6Z"/>',
  chevrons: '<path d="M5.5 4 2 8l3.5 4M10.5 4 14 8l-3.5 4"/>',
  built: '<path d="M2.5 11.5 8 14l5.5-2.5v-7L8 2 2.5 4.5Z"/><path d="M2.5 4.5 8 7l5.5-2.5M8 7v7"/>',
  state: '<circle cx="8" cy="8" r="5.5"/><path d="M8 4.8V8l2.2 1.4"/>',
};
/* the same glyph the sidebar carries for a section, at row size */
const glyph = (name: string) => `<svg class="fnd-glyph" viewBox="0 0 16 16" aria-hidden="true">${glyphs[name]}</svg>`;
---
<div class="stash" data-stash>
  <div class="stash-head">
    <h1>Peter Mei</h1>
    <p>I am a senior at the school, outside Detroit, and I make software. This page is normally a Mac desktop you can click around in, and it needs JavaScript for that. Everything that would be on it is below.</p>
    <p class="stash-note">The same things are also on a plain website: <a href="/site">petermei.com</a>.</p>
  </div>

  {apps.map((a) => {
    const Scene = a.scene ? scenes[a.scene] : null;
    return (
      <section class="stash-app" data-body={a.id} aria-label={a.name}>
        <h2 class="stash-h">{a.name}</h2>
        {a.about && <p class="stash-p">{a.about.line}</p>}
        {a.about && <p class="stash-meta">{a.about.built} · {a.about.state}</p>}
        {a.about?.link && <p><a href={a.about.link.href} rel="noopener">{a.about.link.label}</a></p>}
        {Scene && (
          <div class:list={['sbox', { 'is-flat': a.id === 'volbase' }]} data-fitbox>
            <figure class="sfig" data-scene={a.scene} data-w={a.sw} data-h={a.sh}
                    data-mw={a.mw} data-mh={a.mh} data-flat={a.id === 'volbase' ? '' : undefined}
                    style={`--w:${a.sw}px;--h:${a.sh}px`}>
              <div class="sframe" data-scene-root role="group" aria-label={`A working demo of ${a.name}`}>
                <Scene />
              </div>
            </figure>
          </div>
        )}
      </section>
    );
  })}

  <section class="stash-app" data-body="finder" aria-label="About Peter">
    <h2 class="stash-h">About</h2>
    <div class="fnd is-list">
      <nav class="fnd-side" aria-label="Sidebar">
        <span class="fnd-h">Favorites</span>
        {finder.map((s, i) => (
          <button class:list={['fnd-tab', { 'is-on': i === 0 }]} type="button" data-fnd={s.id}>
            <svg class="fnd-ico" viewBox="0 0 16 16" aria-hidden="true" set:html={glyphs[s.glyph]} /><span>{s.label}</span>
          </button>
        ))}
        <button class="fnd-tab" type="button" data-fnd="pictures">
          <svg class="fnd-ico" viewBox="0 0 16 16" aria-hidden="true" set:html={glyphs.pictures} /><span>Pictures</span>
        </button>
        <span class="fnd-h">Locations</span>
        <a class="fnd-tab" href={links.github} rel="me noopener" target="_blank">
          <svg class="fnd-ico" viewBox="0 0 16 16" aria-hidden="true"><rect x="2" y="3" width="12" height="9" rx="1.5"/><path d="M5.5 14h5M8 12v2"/></svg><span>GitHub</span>
        </a>
      </nav>
      <div class="fnd-main">
        {finder.map((s, i) => (
          <div class:list={['fnd-pane', 'fnd-doc', { 'is-on': i === 0 }]} data-fnd-pane={s.id}>
            <div class="fnd-file">
              <span class="fnd-file-ico"><Icon id="doc" /></span>
              <span class="fnd-file-name"><b>{s.file}</b><small>Plain Text Document</small></span>
            </div>
            <div class="fnd-sheet">
              {s.text.map((t) => <p>{t}</p>)}
            </div>
          </div>
        ))}
        <Pictures />
        <div class="fnd-status" data-fnd-status>1 item</div>
      </div>
    </div>
  </section>

  <section class="stash-app" data-body="photos" aria-label="Photos">
    <h2 class="stash-h">Photos</h2>
    <p class="stash-p">Forty eight photographs I took, in the places on the labels.</p>
    <Photos />
  </section>

  <section class="stash-app" data-body="textedit" aria-label="Read me">
    <h2 class="stash-h">Read me</h2>
    <div class="txt">
      {readme.map((l) => <p>{l}</p>)}
    </div>
  </section>

  <section class="stash-app" data-body="trash" aria-label="Trash">
    <h2 class="stash-h">Trash</h2>
    <div class="fnd">
      {/* the standard Finder sidebar; a row here opens the About window on that section */}
      <nav class="fnd-side" aria-label="Sidebar">
        <span class="fnd-h">Favorites</span>
        {finder.map((s) => (
          <button class="fnd-tab" type="button" data-open="finder" data-pane={s.id}>
            <svg class="fnd-ico" viewBox="0 0 16 16" aria-hidden="true" set:html={glyphs[s.glyph]} /><span>{s.label}</span>
          </button>
        ))}
        <button class="fnd-tab" type="button" data-open="finder" data-pane="pictures">
          <svg class="fnd-ico" viewBox="0 0 16 16" aria-hidden="true" set:html={glyphs.pictures} /><span>Pictures</span>
        </button>
        <span class="fnd-h">Locations</span>
        <a class="fnd-tab" href={links.github} rel="me noopener" target="_blank">
          <svg class="fnd-ico" viewBox="0 0 16 16" aria-hidden="true"><rect x="2" y="3" width="12" height="9" rx="1.5"/><path d="M5.5 14h5M8 12v2"/></svg><span>GitHub</span>
        </a>
      </nav>
      <div class="fnd-main">
        <div class="fnd-pane fnd-pane-empty is-on"><div class="fnd-empty">No Items</div></div>
        <div class="fnd-status">0 items</div>
      </div>
    </div>
  </section>

  {apps.filter((a) => a.about).map((a) => (
    <section class="stash-app" data-body={`about-${a.id}`} aria-label={`About ${a.name}`}>
      <div class:list={['abt', `abt-${a.id}`]}>
        <span class="abt-ico"><Icon id={a.id} /></span>
        <h3 class="abt-name">{a.about!.name}</h3>
        <p class="abt-ver">{a.about!.state}</p>
        <p class="abt-line">{a.about!.line}</p>
        <div class="abt-facts">
          <span><svg viewBox="0 0 16 16" aria-hidden="true" set:html={glyphs.built} /><b>Built</b> {a.about!.built}</span>
          <span><svg viewBox="0 0 16 16" aria-hidden="true" set:html={glyphs.state} /><b>Now</b> {a.about!.state}</span>
        </div>
        <a class="abt-link" href={a.about!.link.href} rel="noopener" target="_blank">{a.about!.link.label}</a>
      </div>
    </section>
  ))}

  <section class="stash-app" data-body="about-peter" aria-label="About Peter">
    <div class="abt abt-peter">
      <span class="abt-ico"><Icon id="peter" /></span>
      <h3 class="abt-name">Peter Mei</h3>
      <p class="abt-ver">Senior, class of 2027</p>
      <p class="abt-line">{aboutPeter}</p>
      <div class="abt-facts">
        <span><svg viewBox="0 0 16 16" aria-hidden="true" set:html={glyphs.hammer} /><b>Made</b> volbase, Rin, Kyou, Market Station</span>
        <span><svg viewBox="0 0 16 16" aria-hidden="true" set:html={glyphs.state} /><b>Now</b> Applying to college this fall</span>
      </div>
      <a class="abt-link" href={links.github} rel="me noopener" target="_blank">github.com/exata531</a>
    </div>
  </section>

  <script type="application/json" data-ph-json set:html={photoJson} />

  {/* icons the scripts clone into Spotlight rows and notifications */}
  {['finder', 'volbase', 'rin', 'kyou', 'market', 'photos', 'textedit', 'trash', 'github', 'settings', 'folder', 'doc', 'safari'].map((id) => (
    <template data-icon={id}><Icon id={id} /></template>
  ))}
</div>

<style is:global>
  /* the demo is pinned to the centre rather than aligned there: a grid item
     wider than its track falls back to start alignment to avoid clipping the
     far edge, which parks a scaled-down demo off to one side */
  .sbox { position: relative; width: 100%; height: 100%; overflow: hidden; }
  .sfig {
    position: absolute; left: 50%; top: 50%; margin: 0;
    width: var(--w); height: var(--h);
    transform: translate(-50%, -50%) scale(var(--s, 1));
  }
  .sframe {
    position: absolute; inset: 0; overflow: hidden; isolation: isolate;
    background: var(--slate); color: var(--slate-fg);
  }
</style>
