---
/* The landing.

   A white page that is also the loading screen. The name, one
   line, and a thin bar that fills as the page actually settles.

   On a desktop the middle of it is the drawn Macintosh on a desk with the real
   desktop live inside its screen: what is in the picture is what is about to fill the
   window, and the screen itself is the way in. The drawing is rendered here
   for the first paint at the shape a desktop window usually has; the script
   redraws it if the visitor's window is shaped differently.

   On a phone there is no drawn machine. A phone inside a phone wastes the
   whole screen to say something the visitor can already see, so the phone
   gets a plain cover: the name, the line, and one button big enough to hit
   with a thumb. Without JavaScript none of this exists: the plain page is
   the whole site. */
import { compact } from '../../scripts/mac/devices';
import { room } from '../../scripts/mac/room';
import Icon from './Icon.astro';

const mac = compact(1.6);
/* the four products, in the order the dock keeps them */
const made = [
  { id: 'volbase', label: 'volbase' },
  { id: 'rin', label: 'Rin' },
  { id: 'kyou', label: 'Kyou' },
  { id: 'market', label: 'Market Station' },
];
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;
const screenStyle = (d: typeof mac) =>
  `left:${pct(d.screen.x, d.vbW)};top:${pct(d.screen.y, d.vbH)};width:${pct(d.screen.w, d.vbW)};height:${pct(d.screen.h, d.vbH)}`;
---
<section class="land" role="main" id="main" data-land aria-busy="true" aria-label="Peter Mei">
  <div class="land-ground" aria-hidden="true"></div>
  {/* the website's own menu, on the Mac's cover: this page is a part of the
      site, so it carries the same pill the other pages do (Peter, 09-13).
      Inside the Mac the menu bar is the Macintosh's own. */}
  <nav class="land-nav" aria-label="Site">
    <a class="lp-face" href="/" aria-label="petermei.com"><span aria-hidden="true">(｡•ᴗ•｡)</span></a>
    <a class="lp-link" href="/">Work</a>
    <a class="lp-link" href="/about">About</a>
    <span class="lp-link is-here" aria-current="page">Playground</span>
  </nav>
  <div class="land-col" data-land-col>
    {/* the cover's picture, drawn only where the machine cannot be: a card
        of the desktop's own grey dither in a black frame, with the four things
        he built on a white strip across its middle. It is the desktop's own
        illustration, not a picture of a phone. */}
    <div class="land-card" aria-hidden="true">
      <span class="land-strip">
        {made.map((a) => <span class="land-chip"><Icon id={a.id} /></span>)}
      </span>
    </div>

    {/* the page still needs a heading; the cover does not need to print it
        (Peter, 09-14: nothing on this page but the cue) */}
    <h1 class="land-name">Peter Mei</h1>

    <div class="land-mac land-imac" data-land-imac data-aspect="1.6" style={`--ar:${(mac.vbW / mac.vbH).toFixed(4)}`}>
      {/* the room around it: the desk's back edge is laid on the machine's
          foot, so the two pictures stay locked together at every size */}
      <div class="land-room" aria-hidden="true" data-land-room><Fragment set:html={room()} /></div>
      <Fragment set:html={mac.svg} />
      <button class="land-screen" type="button" data-land-enter disabled aria-label="Look around the Mac"
              data-r="0" style={screenStyle(mac)}></button>
    </div>

    <button class="land-tap" type="button" data-land-tap disabled>Look around</button>

    <div class="land-foot">
      <p class="land-load" data-land-load>
        <span class="land-bar" role="progressbar" aria-label="Loading" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-land-bar><span class="land-fill" data-land-fill></span></span>
      </p>
      <p class="land-cue" data-land-cue>
        <svg class="land-ptr" viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 1.6v11.9l3.1-3 2.1 4.7 2.3-1-2.1-4.6 4.3-.3Z"/></svg>
        <span data-land-cue-text>Click the screen!!</span>
      </p>
    </div>
  </div>
</section>

<style>
  /* the website's pill, drawn here because the Mac page does not load the
     site's stylesheet: the same glass, the same shapes, the system face */
  /* the column clears the pill, so the name never sits under the glass */
  .land-col { padding-top: 92px; }
  /* the same number the cover's own rule sets, so adding the class moves
     nothing (WEB-062) */
  @media (max-width: 640px) { .land-col { padding-top: 26px; } }
  /* the page under the room is the room's own wall, so there is no seam */
  .land-ground { background: #fcf9f7; }
  /* the cue and the menu stand in front of the room */
  .land-foot, .land-nav { position: relative; z-index: 2; }
  .land-room { position: absolute; left: 50%; bottom: calc(var(--macw, 40vw) * -0.577); width: calc(var(--macw, 40vw) * 3.6); transform: translateX(-50%); z-index: 0; pointer-events: none; }
  .land-room svg { display: block; width: 100%; height: auto; }
  /* the drawing is locked to the machine's foot, so in a tall window it stops
     short of the bottom edge and a band of page ground showed under a
     carefully drawn desk. The floor carries on below it (WEB-068). */
  .land-room::after { content: ''; position: absolute; left: 50%; top: calc(100% - 1px); width: 320vw; height: 100vh; transform: translateX(-50%); background: #f4ece2; }
  /* a disk shows on the desk only once it has been found on the website */
  .land-room :global(.rm-disk) { display: none; }
  .land-room :global(.rm-disk.is-found) { display: block; }
  .land-nav {
    position: absolute; top: 16px; left: 50%; transform: translateX(-50%); z-index: 3;
    display: flex; align-items: center; gap: 4px;
    height: 56px; padding: 0 8px 0 5px; border-radius: 9999px;
    background: rgb(255 255 255 / .55); border: 1px solid rgb(255 255 255 / .6);
    box-shadow: inset 0 4px 6px rgb(255 255 255 / .25), 0 6px 24px rgb(3 3 2 / .08);
    -webkit-backdrop-filter: blur(12px) saturate(160%); backdrop-filter: blur(12px) saturate(160%);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, system-ui, sans-serif;
    color: #030302;
  }
  .lp-face {
    display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%;
    background: #fde99b; font-size: 11px; letter-spacing: -.06em; flex: none; color: #030302;
    text-decoration: none; transition: transform .2s cubic-bezier(.2,.7,.3,1);
  }
  .lp-link {
    display: inline-flex; align-items: center; height: 44px; padding: 0 14px; border-radius: 99px;
    font-size: 16px; font-weight: 500; white-space: nowrap; color: #030302; text-decoration: none;
    transition: background .2s cubic-bezier(.2,.7,.3,1), color .2s cubic-bezier(.2,.7,.3,1), transform .12s cubic-bezier(.2,.7,.3,1);
  }
  .lp-link:hover { background: rgb(3 3 2 / .06); }
  .lp-link:active, .lp-face:active { transform: scale(.96); }
  .lp-link.is-here { background: #030302; color: #fcf9f7; }
  .lp-face:hover { transform: scale(1.06); }
  .land-nav a:focus-visible { outline: 3px solid #030302; outline-offset: 3px; }
  /* the cover on a phone has its own stack; the pill sits above it and shrinks */
  @media (max-width: 640px) {
    .land-nav { height: 56px; top: 10px; padding: 0 6px 0 5px; gap: 2px; }
    .lp-face { width: 44px; height: 44px; font-size: 10px; }
    .lp-link { height: 44px; padding: 0 11px; font-size: 15px; }
  }
  @media (prefers-reduced-motion: reduce) { .lp-link, .lp-face { transition: none; } }
</style>

<script>
  /* the floppies the visitor has found on the website stay on the desk and
     pile up; the website writes the list, this only reads it */
  try {
    const raw = localStorage.getItem('pm-disks');
    const found: string[] = raw ? JSON.parse(raw) : [];
    if (Array.isArray(found)) {
      for (const id of found) {
        document.querySelector(`[data-land-room] [data-disk="${id}"]`)?.classList.add('is-found');
      }
    }
  } catch {}
</script>
