---
/* The Work index: the four, each with its tile, its two sentences, the way
   to open it on the desktop and, where one exists, the public link. */
import Site from '../../../layouts/Site.astro';
import Tile from '../../../components/site/Tile.astro';
import { projects, copy } from '../../../data/site';
---
<Site title="Work" desc="The four things Peter Mei has built that are real enough to show: volbase, Rin, Kyou and Market Station." route="work">
  <section class="top" data-nav-tone="light">
    <div class="wrap">
      <h1 class="h-title">Work</h1>
      <p class="lede" style="margin-top: 18px; max-width: 34ch">{copy.workIntro}</p>
      <ul class="list">
        {projects.map((p) => (
          <li class="entry">
            <Tile p={p} wide caption={false} />
            <div class="entry-t">
              <b>{p.name}</b>
              <p class="body">{p.blurb}</p>
              <div class="acts">
                <a class="btn" href={`/site/work/${p.slug}`}>Read about it<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6.5 3.5 11 8l-4.5 4.5"/></svg></a>
                <a class="btn is-quiet" href={`/?open=${p.open}`} data-open={p.open}>Open it on the desktop</a>
                {p.link && <a class="btn is-quiet" href={p.link.href} rel="noopener" target="_blank" data-tab={p.slug === 'volbase' ? 'volbase' : undefined}>{p.link.label}</a>}
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Site>
