---
/* petermei.com: the home, which is also the Work index. A pinned hero with
   the name and two paragraphs; then the paper with the four tiles, each one
   named under its picture; then the rail of what he built; then the footer. */
import Site from '../../layouts/Site.astro';
import Tile from '../../components/site/Tile.astro';
import { projects, copy, timeline, build, photoFacts, links } from '../../data/site';
const [vb, rin, kyou, ms] = projects;
---
<Site title="petermei.com" desc="Peter Mei is a senior at the school, outside Detroit, and makes software. volbase, Rin, Kyou and Market Station, and the Mac they run on." route="work">
  <section class="hero" data-hero data-nav-tone="light" aria-label="Peter Mei">
    <span class="sun" aria-hidden="true"></span>
    <span class="cloud cloud-a" aria-hidden="true"></span>
    <span class="cloud cloud-b" aria-hidden="true"></span>
    <div class="hero-in">
      <div class="hero-grid">
        <div>
          <h1 class="h-display hero-name">Peter Mei</h1>
          <p class="lede hero-line">{copy.workIntro}</p>
        </div>
        <div class="hero-note">
          <p>The last thing I pushed to this site was a Terminal, some Stickies and a Trash that still has the old versions of the site in it, and it went up on {build.day}. There are {photoFacts.countWord.toLowerCase()} photographs I took in the Photos app on the desktop, and the newest of them are from {photoFacts.newest.place} in {photoFacts.newest.cover.monthLabel.split(' ')[0]}.</p>
          <p>This page is also running inside that Mac, so you can <a href="/mac?open=safari">open it there</a> and see it in a window. The code for all of it is on <a href={links.github} rel="noopener" target="_blank">GitHub</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sheet" data-nav-tone="light" aria-label="Work">
    <div class="wrap">
      <h2 class="h-section intro">I have built four things and all four of them are running somewhere right now.</h2>
      <div class="tiles">
        <div class="row"><Tile p={vb} wide /><Tile p={rin} /></div>
        <div class="row"><Tile p={kyou} /><Tile p={ms} wide /></div>
      </div>
      <div class="acts" style="margin-top: 36px">
        <a class="btn is-quiet" href="/site/work">Read about each one<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6.5 3.5 11 8l-4.5 4.5"/></svg></a>
      </div>
    </div>
  </section>

  <section class="rail-sec" data-nav-tone="light" aria-label="What I built">
    <div class="wrap">
      <h2 class="h-section">Here is what I built, with the newest at the top.</h2>
      <div class="rail-grid">
        <div class="machine">
          <b>Built on a MacBook, from the docs.</b>
          <p>Every one of these was taught to me by its documentation and by getting it wrong first. None of them came with a mentor.</p>
        </div>
        <ol class="rail">
          {timeline.map((s) => (
            <li class="stop">
              <span class:list={['node', { 'is-origin': s.origin }]} aria-hidden="true">
                {s.tone === 'blue' ? <svg viewBox="0 0 16 16"><path d="M2 9.5 6.5 8l2.5-5.5 1.5.5-1.2 5.2L14 9.4l-.3 1.3-4.8-.6-2.6 3.6-1.2-.4 1.2-3.8L2.4 10.8Z"/></svg> : <i></i>}
              </span>
              <span class="stop-t">
                <span>{s.name && <b>{s.name}</b>}{s.name ? ' ' : ''}{s.text} {s.href && <a href={s.href} rel="noopener" target="_blank" data-tab={s.href.includes('volbase') ? 'volbase' : undefined}>{s.href.replace('https://', '')}</a>}{s.open && <> <a href={`/?open=${s.open}`} data-open={s.open}>Open it on the desktop.</a></>}</span>
              </span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>
</Site>
