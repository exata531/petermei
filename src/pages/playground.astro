---
import Site from '../layouts/Site.astro';
import Device from '../components/Device.astro';
import { bySlug } from '../data/work';

const rin = bySlug('rin');
const kyou = bySlug('kyou');
const market = bySlug('market-station');
const volbase = bySlug('volbase');

const faces = [
  '(◕‿◕)', '(ﾉ´ヮ`)ﾉ', '(￣ヮ￣)', '(¬_¬)',
  '(>_<)', '(ツ)', '(♡◡♡)', '(≧◡≦)',
  '(⌒☹⌒)', 'ヽ(・∀・)ﾉ', '(☆_☆)', '(´。• ω •。`)',
];
---
<Site title="Playground — Peter Mei" desc="The working parts of Peter Mei's projects, on one page.">
  <section class="band">
    <div class="wrap top pad">
      <p class="label"><i class="sq"></i>Playground</p>
      <h1 class="title">Touch the work</h1>
      <p class="lead dim">Every one of these is the real thing, running here. Type in them.</p>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <p class="label pad hd"><i class="sq"></i>Rin &#183; type <b>help</b> and press enter</p>
      <div class="stage pad">
        <Device scene="rin" w={rin.w} h={rin.h} mw={rin.mw} mh={rin.mh} r={rin.r} name="Rin" />
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap cells two">
      <div>
        <p class="label pad hd"><i class="sq"></i>Kyou &#183; tap the field and type</p>
        <div class="stage pad">
          <Device scene="kyou" w={kyou.w} h={kyou.h} mw={kyou.mw} mh={kyou.mh} r={kyou.r} name="Kyou" />
        </div>
      </div>
      <div>
        <p class="label pad hd"><i class="sq"></i>Faces &#183; pick one</p>
        <div class="stage pad" data-picker>
          <output class="big mono" data-picker-out>{faces[0]}</output>
          <div class="chips">
            {faces.map((f) => (
              <button class="chip mono" type="button" data-face={f}>{f}</button>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <p class="label pad hd"><i class="sq"></i>Market Station &#183; it ticks on its own</p>
      <div class="stage pad">
        <Device scene="market" w={market.w} h={market.h} mw={market.mw} mh={market.mh} r={market.r} name="Market Station" />
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <p class="label pad hd"><i class="sq"></i>volbase &#183; switch the tab, watch the pins land</p>
      <div class="stage pad">
        <Device scene="volbase" w={volbase.w} h={volbase.h} mw={volbase.mw} mh={volbase.mh} r={volbase.r} name="volbase" />
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap cells two">
      <div>
        <p class="label pad hd"><i class="sq"></i>Where I am right now</p>
        <div class="stage pad now">
          <span class="huge mono" data-bigclock>&#183;&#183;&#183;&#183;&#183;</span>
          <span class="meta" data-bigwx>Detroit, Michigan</span>
        </div>
      </div>
      <a class="pad go-tile" href="/about">
        <p class="label"><i class="sq"></i>Photos</p>
        <p class="sub">Twelve things I walked past, on the about page.</p>
        <span class="go mono" aria-hidden="true">Open <i>&#8627;</i></span>
      </a>
    </div>
  </section>
</Site>

<style>
  .top { padding-block: clamp(48px, 8vw, 110px); display: grid; gap: 18px; }
  .hd { border-bottom: 1px solid var(--hair); }
  .stage { background: var(--paper-2); padding-block: clamp(28px, 4vw, 56px); }

  .big { font-size: clamp(38px, 6vw, 68px); line-height: 1.25; display: block; text-align: center; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin-top: 26px; }
  .chip {
    background: var(--paper); border: 1px solid var(--hair); cursor: pointer;
    padding: 9px 12px; font-size: 14px; line-height: 1;
    transition: background var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease);
  }
  .chip:hover { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .chip[aria-pressed='true'] { border-color: var(--accent); color: var(--accent); }

  .now { display: grid; place-content: center; gap: 12px; text-align: center; min-height: 200px; }
  .huge { font-size: clamp(40px, 6vw, 72px); letter-spacing: -.04em; font-weight: 500; }

  .two { grid-template-columns: 1fr 1fr; }
  .go-tile { display: grid; gap: 16px; align-content: center; }
  .go-tile:hover { background: var(--paper-2); }
  .go {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: var(--t-label); text-transform: uppercase;
    letter-spacing: var(--track-label); color: var(--accent);
  }
  .go i { font-style: normal; transition: transform var(--t-base) var(--ease); }
  .go-tile:hover .go i { transform: translate(4px, 2px); }

  @media (max-width: 860px) { .two { grid-template-columns: 1fr; } }
</style>
