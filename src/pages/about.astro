---
/* About: the long one, pinned, with four of his photos as paper on the
   right; then one paragraph of what he has done; then the last two. */
import Site from '../layouts/Site.astro';
import { copy, pile } from '../data/site';
/* the four sit clear of each other's caption strips, so every label reads;
   under 768 the stylesheet lays them two by two inside the column */
const spots = [
  { x: 6, y: 0, r: -2.06 }, { x: 250, y: 34, r: -6.5 }, { x: 60, y: 212, r: 4.4 }, { x: 288, y: 246, r: 2.6 },
];
---
<Site title="About" desc="Peter Mei, a high school senior in Michigan, on why he makes software, the robotics team, climbing, and what is next." route="about">
  <section class="about-hero" data-hero data-nav-tone="light" aria-labelledby="about-h">
    <div class="about-grid">
      <div class="about-copy">
        <h1 class="h-title" id="about-h">About</h1>
        {copy.about.slice(0, 3).map((t) => <p>{t}</p>)}
      </div>
      <div class="pile" data-pile role="group" aria-label="Four photographs">
        {pile.map((ph, i) => (
          <figure class="polaroid" data-polaroid style={`--x:${spots[i].x}px;--y:${spots[i].y}px;--r:${spots[i].r}deg;z-index:${i + 1}`}>
            <img src={ph.thumb} width={ph.w} height={ph.h} alt={ph.alt} loading="lazy" decoding="async" draggable="false" />
            <small>{ph.place}</small>
          </figure>
        ))}
        <button class="pile-reset" type="button" data-pile-reset aria-label="Put the photos back">
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4.5 10a5.5 5.5 0 1 1 1.6 3.9"/><path d="M4.5 16.5v-3.2h3.2"/></svg>
        </button>
      </div>
    </div>
  </section>

  <section class="done-sec" data-nav-tone="light" aria-labelledby="done-h">
    <div class="wrap">
      <h2 class="h-section" id="done-h" data-rise>{copy.doneHead}</h2>
      <p class="done-p">{copy.done}</p>
      <div class="about-after">
        <p>{copy.about[3]}</p>
        <p class="now">{copy.about[4]}</p>
        <div class="acts">
          <a class="btn is-quiet" href="/mac?open=photos" data-open="photos">Open the Photos app</a>
          <a class="btn is-quiet" href="/">Read about the things I have built</a>
        </div>
      </div>
    </div>
  </section>
</Site>
