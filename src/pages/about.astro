---
import Site from '../layouts/Site.astro';

const photos = Array.from({ length: 12 }, (_, i) => `/img/photos/p-${String(i + 1).padStart(2, '0')}.webp`);

const facts = [
  ['School', 'the school Kingswood, class of 2027'],
  ['Where', 'The Detroit area, Michigan'],
  ['Languages', 'English, Mandarin'],
  ['Building with', 'Next.js, Swift, Python, Raspberry Pi'],
  ['Robotics', 'Founded my school&#8217;s FIRST team, went to Worlds in our first year'],
  ['Climbing', 'Bouldering mostly. Flash V7, projecting V10'],
  ['Running', 'Two varsity cross country seasons. 5k in 18:39'],
];
---
<Site title="About — Peter Mei" desc="Peter Mei, a senior outside Detroit who builds software.">
  <section class="band">
    <div class="wrap top pad">
      <p class="label"><i class="sq"></i>About</p>
      <h1 class="title">Peter Mei</h1>
      <p class="lead say">
        I started building things before I knew how, and I never stopped. Almost all of it is
        self taught: Next.js first, then Swift, then whatever the next project needed. I founded
        my school&#8217;s robotics team and we made it to Worlds in our first year. I climb most
        days. I am applying to college this fall.
      </p>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <dl class="facts">
        {facts.map(([k, v]) => (
          <div class="fact pad">
            <dt class="label">{k}</dt>
            <dd set:html={v} />
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="band" aria-labelledby="ph-h">
    <div class="wrap">
      <p class="label pad hd" id="ph-h"><i class="sq"></i>Things I walked past</p>
      <ul class="grid rise">
        {photos.map((src, i) => (
          <li>
            <img src={src} width="1086" height="724" alt="" loading="lazy" decoding="async"
                 style={`--d:${(i % 4) * 40}ms`} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band">
    <div class="wrap cells three">
      <a class="out pad" href="https://github.com/exata531" rel="me noopener">
        <span class="label"><i class="sq"></i>Code</span>
        <span class="sub">GitHub &#8599;</span>
      </a>
      <a class="out pad" href="https://volbase.app" rel="noopener">
        <span class="label"><i class="sq"></i>Live</span>
        <span class="sub">volbase.app &#8599;</span>
      </a>
      <a class="out pad" href="/playground">
        <span class="label"><i class="sq"></i>More</span>
        <span class="sub">Playground &#8627;</span>
      </a>
    </div>
  </section>
</Site>

<style>
  .top { padding-block: clamp(48px, 8vw, 110px); display: grid; gap: 20px; }
  .say { max-width: 52ch; color: var(--dim); font-size: 20px; }
  .say :global(strong) { color: var(--ink); }

  .facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 0; }
  .fact {
    display: grid; gap: 8px; padding-block: 26px;
    border-bottom: 1px solid var(--hair);
  }
  .fact:nth-child(odd) { border-right: 1px solid var(--hair); }
  /* an odd count leaves a half-empty row, so the last fact takes the width */
  .fact:last-child:nth-child(odd) { grid-column: 1 / -1; border-right: 0; }
  .facts > div:last-child { border-bottom: 0; }
  dt, dd { margin: 0; }
  .fact dd { font-size: var(--t-lead); letter-spacing: -.01em; }

  .hd { border-bottom: 1px solid var(--hair); }
  .grid {
    display: grid; grid-template-columns: repeat(4, 1fr);
  }
  .grid li { border-right: 1px solid var(--hair); border-bottom: 1px solid var(--hair); }
  .grid li:nth-child(4n) { border-right: 0; }
  .grid li:nth-child(n+9) { border-bottom: 0; }
  .grid img {
    width: 100%; height: 100%; aspect-ratio: 3 / 2; object-fit: cover;
    filter: grayscale(1) contrast(1.02);
    transition: filter var(--t-slow) var(--ease), transform var(--t-slow) var(--ease);
  }
  .grid li:hover img { filter: none; transform: scale(1.02); }

  .three { grid-template-columns: repeat(3, 1fr); }
  .out { display: grid; gap: 12px; padding-block: 34px; align-content: start; }
  .out:hover { background: var(--paper-2); }
  .out .sub { font-size: var(--t-sub); }

  @media (max-width: 860px) {
    .facts { grid-template-columns: 1fr; }
    .fact:nth-child(odd) { border-right: 0; }
    .grid { grid-template-columns: repeat(2, 1fr); }
    .grid li:nth-child(4n) { border-right: 1px solid var(--hair); }
    .grid li:nth-child(2n) { border-right: 0; }
    .grid li:nth-child(n+9) { border-bottom: 1px solid var(--hair); }
    .grid li:nth-last-child(-n+2) { border-bottom: 0; }
    .three { grid-template-columns: 1fr; }
  }
</style>
