---
import Site from '../../layouts/Site.astro';
import Device from '../../components/Device.astro';
import { work, nextOf } from '../../data/work';

export function getStaticPaths() {
  return work.map((w) => ({ params: { slug: w.slug }, props: { w } }));
}
const { w } = Astro.props;
const next = nextOf(w.slug);
---
<Site title={`${w.name} — Peter Mei`} desc={w.line}>
  <article class="band">
    <div class="wrap case">
      <!-- left: stays put while the visuals scroll -->
      <div class="side">
        <div class="side-in pad">
          <a class="back mono" href="/">&#8592; Back</a>
          <h1 class="title">{w.name}</h1>
          <p class="role dim">{w.role}</p>
          <dl class="facts">
            <div><dt class="label">Built with</dt><dd class="meta">{w.built}</dd></div>
            <div><dt class="label">Status</dt><dd class="meta">{w.status}</dd></div>
            {w.link && (
              <div>
                <dt class="label">Link</dt>
                <dd class="meta"><a class="lnk" href={w.link.href} rel="noopener">{w.link.label} &#8599;</a></dd>
              </div>
            )}
          </dl>
        </div>
      </div>

      <!-- right: the product, big, and almost nothing else -->
      <div class="reel">
        <section class="frame first" data-swap>
          <div class="live-wrap">
            <img
              class="still" data-swap-still src={w.still.src}
              width={w.still.w} height={w.still.h} alt={`${w.name}, running`}
              decoding="async" transition:name={`shot-${w.slug}`}
            />
            <div class="demo-live">
              <Device scene={w.scene} w={w.w} h={w.h} mw={w.mw} mh={w.mh} r={w.r} name={w.name} />
            </div>
          </div>
          <p class="meta cap"><span class="tag">Live</span>{w.live}</p>
        </section>

        <section class="frame note rise">
          <p class="label"><i class="sq"></i>{w.hard.q}</p>
          <p class="lead">{w.hard.a}</p>
        </section>

        {w.shots.map((s) => (
          <section class="frame rise">
            <img src={s.src} width={s.w} height={s.h} alt={s.cap} loading="lazy" decoding="async" />
            <p class="meta cap">{s.cap}</p>
          </section>
        ))}
      </div>
    </div>

    <div class="wrap">
      <a class="next" href={`/work/${next.slug}`}>
        <span class="label"><i class="sq"></i>Next project</span>
        <span class="next-n title">{next.name}</span>
        <span class="go mono" aria-hidden="true">Open <i>&#8627;</i></span>
      </a>
    </div>
  </article>
</Site>

<style>
  .case { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); }
  .side { border-right: 1px solid var(--hair); }
  .side-in {
    position: sticky; top: calc(var(--nav) + 1px);
    display: grid; gap: 18px; align-content: start;
    padding-block: clamp(36px, 5vw, 72px);
  }
  .back {
    font-size: var(--t-label); text-transform: uppercase;
    letter-spacing: var(--track-label); color: var(--dim);
    width: fit-content;
  }
  .back:hover { color: var(--accent); }
  .role { font-size: var(--t-lead); line-height: 1.3; letter-spacing: -.01em; }
  .facts { display: grid; gap: 0; margin-top: 12px; border-top: 1px solid var(--hair); }
  .facts > div {
    display: grid; grid-template-columns: 96px 1fr; gap: 14px;
    align-items: baseline; padding-block: 13px;
    border-bottom: 1px solid var(--hair);
  }
  dt, dd { margin: 0; }
  .facts dd { color: var(--ink); }

  .reel { display: grid; grid-template-columns: minmax(0, 1fr); }
  .frame {
    padding: clamp(24px, 3.4vw, 52px) var(--pad) clamp(28px, 3.4vw, 52px);
    border-bottom: 1px solid var(--hair);
    background: var(--paper-2);
  }
  .frame:last-child { border-bottom: 0; }
  .frame.note { background: var(--paper); display: grid; gap: 16px; }
  .frame.note .lead { max-width: 46ch; color: var(--ink); }
  /* a tall phone and a wide dashboard are capped on both axes so the reel
     keeps one rhythm and the still holds the same box the demo will take */
  .frame img {
    width: auto; height: auto; max-width: 100%;
    max-height: min(72vh, 680px); margin-inline: auto;
    border-radius: var(--r-photo);
  }
  .frame.first .still { border-radius: var(--r-screen); box-shadow: var(--shadow-screen); }
  .live-wrap { position: relative; }
  .cap { margin-top: 16px; display: flex; gap: 10px; align-items: baseline; }
  .tag {
    color: var(--accent); font-weight: 600; text-transform: uppercase;
    letter-spacing: var(--track-label); font-size: var(--t-label);
  }

  .next {
    display: grid; gap: 12px; padding: clamp(40px, 6vw, 88px) var(--pad);
    border-top: 1px solid var(--hair);
  }
  .next:hover { background: var(--paper-2); }
  .go {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: var(--t-label); text-transform: uppercase;
    letter-spacing: var(--track-label); color: var(--accent);
  }
  .go i { font-style: normal; transition: transform var(--t-base) var(--ease); }
  .next:hover .go i { transform: translate(4px, 2px); }

  @media (max-width: 860px) {
    .case { grid-template-columns: 1fr; }
    .side { border-right: 0; border-bottom: 1px solid var(--hair); }
    .side-in { position: static; }
    .facts > div { grid-template-columns: 90px 1fr; }
  }
</style>
