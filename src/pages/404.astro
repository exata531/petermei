---
import Site from '../layouts/Site.astro';
import { work } from '../data/work';
---
<Site title="Not here — Peter Mei" desc="That page does not exist.">
  <section class="band">
    <div class="wrap lost pad">
      <p class="label"><i class="sq"></i>404</p>
      <h1 class="display">Not here</h1>
      <p class="sub">That page does not exist. The work does.</p>
      <a class="btn" href="/">Go to the work</a>
    </div>
  </section>

  <section class="band">
    <div class="wrap cells four">
      {work.map((w) => (
        <a class="pick pad" href={`/work/${w.slug}`}>
          <span class="label"><i class="sq"></i>{w.n}</span>
          <span class="sub">{w.name}</span>
        </a>
      ))}
    </div>
  </section>
</Site>

<style>
  .lost { padding-block: clamp(70px, 13vw, 170px); display: grid; gap: 22px; justify-items: start; }
  .lost .btn { margin-top: 12px; }
  .four { grid-template-columns: repeat(4, 1fr); }
  .pick { display: grid; gap: 12px; padding-block: 34px; align-content: start; }
  .pick:hover { background: var(--paper-2); }
  @media (max-width: 860px) { .four { grid-template-columns: 1fr 1fr; } }
</style>
