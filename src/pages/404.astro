---
import Mac from '../layouts/Mac.astro';
import Wallpaper from '../components/mac/Wallpaper.astro';
---
<Mac title="Not here — Peter Mei" desc="That page does not exist on this desktop.">
  <div class="desk lost-desk">
    <Wallpaper />
  </div>

  <div class="lost">
    <section class="win is-front lost-win">
      <header class="win-bar">
        <span class="lights">
          <span class="lt lt-c"></span><span class="lt lt-m"></span><span class="lt lt-z"></span>
        </span>
        <span class="win-title">Finder</span>
        <span class="win-pad"></span>
      </header>
      <div class="win-body lost-body">
        <p class="lost-face mono">(・_・;)</p>
        <h1 class="lost-h">The item can’t be found.</h1>
        <p class="lost-p">There is no such thing on this desktop.</p>
        <a class="lost-btn" href="/">Go to the desktop</a>
      </div>
    </section>
  </div>
</Mac>

<style is:global>
  .lost-desk { opacity: 1; }
  .lost {
    position: fixed; inset: 0; z-index: 5;
    display: grid; place-items: center; padding: 20px;
  }
  .lost-win { position: relative; width: min(420px, 100%); height: auto; }
  .lost-body { display: grid; justify-items: center; gap: 10px; padding: 30px 26px 30px; text-align: center; }
  .lost-face { font-size: 26px; letter-spacing: -.04em; }
  .lost-h { font-size: 19px; font-weight: 600; letter-spacing: -.02em; }
  .lost-p { font-size: 13.5px; color: var(--dim); }
  .lost-btn {
    margin-top: 8px; padding: 7px 16px; border-radius: 999px;
    background: var(--sel); color: var(--sel-fg); font-size: 13px;
  }
</style>
