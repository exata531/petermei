---
import Mac from '../layouts/Mac.astro';
import Icon from '../components/mac/Icon.astro';
---
<Mac title="Not here, Peter Mei" desc="That page does not exist on this Macintosh.">
  <div class="desk lost-desk"></div>

  <div class="lost">
    <section class="alert lost-box" role="alertdialog" aria-labelledby="lost-h">
      <span class="alert-ico"><Icon id="stop" /></span>
      <div>
        <h1 class="alert-title" id="lost-h">The item could not be found.</h1>
        <p class="alert-wait">There is no such thing on this Macintosh.</p>
      </div>
      <div class="alert-btns"><a class="alert-btn is-default" href="/">OK</a></div>
    </section>
  </div>
</Mac>

<style is:global>
  html { background: var(--paper) var(--dither); background-size: var(--dither-size); }
  .lost { position: fixed; inset: 0; z-index: 5; display: grid; place-items: center; padding: 20px; }
  .lost-box { grid-template-columns: var(--icon) 1fr; }
  .lost-box .alert-ico { grid-row: 1; }
  .lost-box .alert-wait { margin-top: var(--u2); }
</style>
