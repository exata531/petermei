---
import Mac from '../layouts/Mac.astro';
import Wallpaper from '../components/mac/Wallpaper.astro';
import MenuBar from '../components/mac/MenuBar.astro';
import Dock from '../components/mac/Dock.astro';
import Stash from '../components/mac/Stash.astro';
import Icon from '../components/mac/Icon.astro';
import { readme } from '../data/apps';
import { deskPhotos } from '../data/photos';

const padApps = [
  { id: 'volbase', label: 'volbase' },
  { id: 'rin', label: 'Rin' },
  { id: 'kyou', label: 'Kyou' },
  { id: 'market', label: 'Market Station' },
  { id: 'finder', label: 'About Peter' },
  { id: 'photos', label: 'Photos' },
  { id: 'textedit', label: 'Read me' },
  { id: 'trash', label: 'Trash' },
];
---
<Mac
  title="Peter Mei"
  desc="Peter Mei builds software outside Detroit. This portfolio is a Mac desktop: volbase, Rin, Kyou and Market Station open as apps on it."
>
  <!-- the desktop -->
  <div class="desk" data-desk>
    <Wallpaper />

    <ul class="items" aria-label="Desktop">
      <li>
        <button class="item" type="button" data-open="textedit">
          <span class="item-ico"><Icon id="textedit" /></span>
          <span class="item-lbl">Read me</span>
        </button>
      </li>
      <li>
        <button class="item" type="button" data-open="finder" data-pane="pictures">
          <span class="item-ico"><Icon id="folder" /></span>
          <span class="item-lbl">Pictures</span>
        </button>
      </li>
      <li>
        <button class="item" type="button" data-open="finder">
          <span class="item-ico"><Icon id="folder" /></span>
          <span class="item-lbl">About Peter</span>
        </button>
      </li>
      {deskPhotos.map((p) => (
        <li>
          <button class="item item-file" type="button" data-open="photos" data-photo={p.i} aria-label={`${p.name}, ${p.alt}`}>
            <span class="item-ico"><span class="item-pic" data-orient={p.w >= p.h ? 'l' : 'p'}><img src={p.icon} width={p.w} height={p.h} alt="" decoding="async" draggable="false" /></span></span>
            <span class="item-lbl">{p.name}</span>
          </button>
        </li>
      ))}
    </ul>

    <div class="wins" data-wins></div>
  </div>

  <!-- the phone: a home screen instead of a desktop -->
  <div class="home" data-home>
    <div class="home-pad">
      <div class="widget" aria-label="Read me">
        <span class="widget-h"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 2.5h10v11H3z"/><path d="M5.5 6h5M5.5 9h5"/></svg>Read me</span>
        {readme.map((l) => <p>{l}</p>)}
      </div>
      <ul class="pad">
        {padApps.map((a) => (
          <li>
            <button class="pad-i" type="button" data-open={a.id}>
              <span class="pad-tile"><Icon id={a.id} /></span>
              <span class="pad-lbl">{a.label}</span>
            </button>
          </li>
        ))}
      </ul>
    </div>

    <nav class="pdock" aria-label="Dock">
      <button class="pad-i" type="button" data-open="finder">
        <span class="pad-tile"><Icon id="finder" /></span><span class="sr">About Peter</span>
      </button>
      <button class="pad-i" type="button" data-open="volbase">
        <span class="pad-tile"><Icon id="volbase" /></span><span class="sr">volbase</span>
      </button>
      <button class="pad-i" type="button" data-open="rin">
        <span class="pad-tile"><Icon id="rin" /></span><span class="sr">Rin</span>
      </button>
      <a class="pad-i" href="https://github.com/exata531" rel="me noopener" target="_blank">
        <span class="pad-tile"><Icon id="github" /></span><span class="sr">GitHub</span>
      </a>
    </nav>

    <span class="home-ind" aria-hidden="true"></span>

    <div class="sheet" data-sheet hidden>
      <div class="sheet-top" data-sheet-top>
        <span class="sheet-grab" aria-hidden="true"></span>
        <span class="sheet-name" data-sheet-name></span>
        <button class="sheet-x" type="button" data-sheet-close aria-label="Close">Done</button>
      </div>
      <div class="sheet-body" data-sheet-body></div>
    </div>
  </div>

  <MenuBar />
  <Dock />

  <div class="notifs" data-notifs aria-live="polite"></div>
  <div class="menu" data-ctx hidden role="menu"></div>

  <!-- Spotlight, at the body level so no transform can trap it -->
  <div class="spot" data-spot hidden>
    <div class="spot-box">
      <div class="spot-field">
        <svg class="spot-ico" viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.6" cy="8.6" r="5.4"/><path d="M12.6 12.6L17.4 17.4"/></svg>
        <input data-sp-in type="text" placeholder="Spotlight Search" aria-label="Spotlight Search"
               autocomplete="off" autocapitalize="off" spellcheck="false" />
      </div>
      <ul class="spot-list" data-sp-list></ul>
    </div>
  </div>

  <button class="sleep" data-sleep hidden aria-label="Wake"></button>

  <Stash />
</Mac>
