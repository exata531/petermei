---
import Base from '../layouts/Base.astro';
import MenuBar from '../components/MenuBar.astro';
import SubNav from '../components/SubNav.astro';
import Hero from '../components/Hero.astro';
import Thread from '../components/Thread.astro';
import Rooms from '../components/Rooms.astro';
import Notes from '../components/Notes.astro';
import Photos from '../components/Photos.astro';
import About from '../components/About.astro';
import Footer from '../components/Footer.astro';
---
<Base>
  <MenuBar />
  <SubNav />
  <main>
    <Hero />
    <Thread dir="rl" />
    <Rooms />
    <Notes />
    <Photos />
    <About />
  </main>
  <Footer />
</Base>
