---
import Mac from '../layouts/Mac.astro';
import MenuBar from '../components/mac/MenuBar.astro';
import Stash from '../components/mac/Stash.astro';
import Landing from '../components/mac/Landing.astro';
import Icon from '../components/mac/Icon.astro';
import { readmeCard } from '../data/apps';
import { deskPhotos } from '../data/photos';

/* the desktop, the way a Macintosh kept one: the hard disk at the top right,
   then a column of the things on it, the Trash on its own in the corner.
   There is no dock; every application is an icon you double click. */
const deskItems = [
  { id: 'finder', icon: 'hd', label: 'Macintosh HD' },
  { id: 'volbase', icon: 'volbase', label: 'volbase' },
  { id: 'rin', icon: 'rin', label: 'Rin' },
  { id: 'kyou', icon: 'kyou', label: 'Kyou' },
  { id: 'market', icon: 'market', label: 'Market Station' },
  { id: 'textedit', icon: 'textedit', label: 'Read Me' },
  { id: 'pictures', icon: 'folder', label: 'Pictures' },
  { id: 'photos', icon: 'photos', label: 'Photos' },
  { id: 'terminal', icon: 'terminal', label: 'Terminal' },
];
/* the phone holds the same things in a grid of three */
const padApps = [
  { id: 'finder', icon: 'hd', label: 'Macintosh HD' },
  { id: 'volbase', icon: 'volbase', label: 'volbase' },
  { id: 'rin', icon: 'rin', label: 'Rin' },
  { id: 'kyou', icon: 'kyou', label: 'Kyou' },
  { id: 'market', icon: 'market', label: 'Market Station' },
  { id: 'pictures', icon: 'folder', label: 'Pictures' },
  { id: 'photos', icon: 'photos', label: 'Photos' },
  { id: 'terminal', icon: 'terminal', label: 'Terminal' },
  { id: 'trash', icon: 'trash', label: 'Trash' },
];
---
<Mac
  title="Peter Mei"
  desc="Peter Mei is a senior at the school, outside Detroit, and makes software. This portfolio is a Macintosh running System 7: volbase, Rin, Kyou and Market Station open as applications on it."
>
  <!-- the machine: everything that is the computer, so the landing can hold
       it in a picture and the way in can move it as one thing -->
  <div class="mac is-pending" data-mac>

  <!-- the desktop -->
  <div class="desk" data-desk>
    <ul class="items" aria-label="Desktop">
      {deskItems.map((d) => (
        <li>
          <button class="item" type="button" data-open={d.id}>
            <span class="item-ico"><Icon id={d.icon} /></span>
            <span class="item-lbl">{d.label}</span>
          </button>
        </li>
      ))}
      <li>
        <a class="item" href="https://github.com/exata531" rel="me noopener" target="_blank" data-open="github">
          <span class="item-ico"><Icon id="github" /></span>
          <span class="item-lbl">GitHub</span>
        </a>
      </li>
      {deskPhotos.map((p) => (
        <li>
          <button class="item item-file" type="button" data-open="photos" data-photo={p.i} aria-label={`${p.name}, ${p.alt}`}>
            <span class="item-ico"><span class="item-pic" data-orient={p.w >= p.h ? 'l' : 'p'}><img src={p.icon} width={p.w} height={p.h} alt="" decoding="async" draggable="false" /></span></span>
            <span class="item-lbl">{p.name}</span>
          </button>
        </li>
      ))}
    </ul>
    <button class="item item-trash" type="button" data-open="trash" data-trash-icon>
      <span class="item-ico"><Icon id="trash" /></span>
      <span class="item-lbl">Trash</span>
    </button>

    <div class="wins" data-wins></div>
    <div class="stickies" data-stickies></div>
  </div>

  <!-- the phone: the same desktop, held in one hand -->
  <div class="home" data-home>
    <div class="home-pad">
      <button class="widget" type="button" data-open="textedit">
        <span class="wbox wbox-c widget-x" role="button" tabindex="0" data-widget-close aria-label="Close"></span>
        <span class="widget-h">Read Me</span>
        <span class="widget-p">{readmeCard}</span>
        <span class="widget-more">Open the rest</span>
      </button>
      <ul class="pad">
        {padApps.map((a) => (
          <li>
            <button class="pad-i" type="button" data-open={a.id}>
              <span class="pad-tile"><Icon id={a.icon} /></span>
              <span class="pad-lbl">{a.label}</span>
            </button>
          </li>
        ))}
        <li>
          <a class="pad-i" href="https://github.com/exata531" rel="me noopener" target="_blank">
            <span class="pad-tile"><Icon id="github" /></span>
            <span class="pad-lbl">GitHub</span>
          </a>
        </li>
      </ul>
    </div>

    <div class="sheet" data-sheet hidden>
      <div class="sheet-top" data-sheet-top>
        <span class="sheet-grab" aria-hidden="true"></span>
        <span class="sheet-name" data-sheet-name></span>
        <button class="sheet-x" type="button" data-sheet-close aria-label="Close">Close</button>
      </div>
      <div class="sheet-body" data-sheet-body></div>
      <div class="sheet-foot" data-sheet-foot hidden>
        <div class="sheet-power" role="group" aria-label="Special">
          <button class="sheet-row" type="button" data-power="sleep">Sleep</button>
          <button class="sheet-row" type="button" data-power="shutdown">Shut Down</button>
        </div>
      </div>
    </div>
  </div>

  <MenuBar />

  <!-- "Welcome to Macintosh." over the desktop while it boots -->
  <div class="welcome-veil" data-welcome hidden>
    <div class="welcome">Welcome to Macintosh.</div>
    <div class="welcome-ext" data-welcome-ext aria-hidden="true">
      <Icon id="volbase" /><Icon id="rin" /><Icon id="kyou" /><Icon id="market" />
    </div>
  </div>

  <!-- the screen's black: inside the machine so it scales with the screen -->
  <div class="mac-blank" data-mac-blank aria-hidden="true"></div>
  </div>

  <div class="menu" data-menu-pop hidden role="menu"></div>
  <div class="notifs" data-notifs aria-live="polite"></div>
  <div class="menu" data-ctx hidden role="menu"></div>

  <!-- Find File, at the body level so no transform can trap it -->
  <div class="spot" data-spot hidden>
    <div class="spot-box" role="dialog" aria-label="Find File">
      <button class="wbox wbox-c spot-x" type="button" data-sp-close aria-label="Close"></button>
      <div class="spot-field">
        <input data-sp-in type="text" placeholder="" aria-label="Find items whose name contains"
               autocomplete="off" autocapitalize="off" spellcheck="false" />
      </div>
      <ul class="spot-list" data-sp-list></ul>
    </div>
  </div>

  <!-- the alert a Macintosh shows before it restarts or shuts down -->
  <div class="alert-veil" data-alert hidden>
    <div class="alert" data-alert-box role="alertdialog" aria-modal="true" aria-labelledby="alert-title" aria-describedby="alert-wait">
      <span class="alert-ico" aria-hidden="true"><Icon id="caution" /></span>
      <p class="alert-title" id="alert-title" data-alert-title></p>
      <label class="alert-chk"><input type="checkbox" checked /><span>Reopen windows when logging back in</span></label>
      <p class="alert-wait" id="alert-wait" data-alert-wait></p>
      <div class="alert-btns">
        <button class="alert-btn" type="button" data-alert-cancel>Cancel</button>
        <button class="alert-btn is-default" type="button" data-alert-ok>Restart</button>
      </div>
    </div>
  </div>

  <Landing />

  <Stash />
</Mac>
