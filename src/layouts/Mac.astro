---
import '../styles/tokens.css';
import '../styles/mac.css';

interface Props { title: string; desc: string; }
const { title, desc } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site ?? 'https://petermei.com');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={url.href} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#cfe0f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1018" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={url.href} />
    <meta property="og:image" content={new URL('/og.png', url).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      /* before the first paint, so the desktop never flashes the wrong appearance */
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var t = localStorage.getItem('appearance');
          if (t === 'light' || t === 'dark') d.dataset.theme = t;
        } catch (e) {}
        /* the landing shows once per tab: after that a reload lands on the desktop */
        try { if (sessionStorage.getItem('mac-in')) d.classList.add('in'); } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <slot />
    <script>import '../scripts/mac/desk';</script>
  </body>
</html>
