---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/geist';
import '@fontsource-variable/jetbrains-mono';
import '../styles/tokens.css';
import '../styles/base.css';
import Nav from '../components/Nav.astro';
import Foot from '../components/Foot.astro';

interface Props { title: string; desc: string; }
const { title, desc } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site ?? 'https://petermei.com');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={url.href} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#efeeea" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={url.href} />
    <meta property="og:image" content={new URL('/og.png', url).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <ClientRouter />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main"><slot /></main>
    <Foot />
    <script>import '../scripts/site';</script>
  </body>
</html>
